+@code {
+    private bool restaurado;
+
+    protected override async Task OnInitializedAsync()
+    {
+        // Tenta restaurar um login salvo neste navegador (Local Storage)
+        // antes de decidir se mostra a rota pedida ou redireciona para
+        // /login — evita pedir login de novo a cada F5 no tablet/TV do
+        // salão, que fica ligado o dia todo com o mesmo usuário.
+        await TokenStore.RestaurarAsync();
+        restaurado = true;
+    }
+}
