# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY ["SimuladorMegaHair.Web/SimuladorMegaHair.Web.csproj", "SimuladorMegaHair.Web/"]
COPY ["SimuladorMegaHair.Domain/SimuladorMegaHair.Domain.csproj", "SimuladorMegaHair.Domain/"]
RUN dotnet restore "SimuladorMegaHair.Web/SimuladorMegaHair.Web.csproj"

COPY . .
RUN dotnet publish "SimuladorMegaHair.Web/SimuladorMegaHair.Web.csproj" \
    -c Release \
    -o /app/publish \
    --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
EXPOSE 5180
ENV ASPNETCORE_URLS=http://+:5180
ENV ASPNETCORE_ENVIRONMENT=Development
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "SimuladorMegaHair.Web.dll"]
