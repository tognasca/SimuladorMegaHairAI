<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Fundos -->
    <Color x:Key="PageBackgroundColor">#0A0A0C</Color>
    <Color x:Key="SidebarColor">#0F0F12</Color>
    <Color x:Key="CardColor">#141418</Color>
    <Color x:Key="CardHoverColor">#1C1C22</Color>
    <Color x:Key="InputColor">#1A1A20</Color>

    <!-- Dourado LUXE -->
    <Color x:Key="GoldPrimary">#D4A857</Color>
    <Color x:Key="GoldLight">#E8C87A</Color>
    <Color x:Key="GoldDark">#A68542</Color>
    <Color x:Key="GoldSoft">#8B7340</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimary">#F5F1EA</Color>
    <Color x:Key="TextSecondary">#B5B0A5</Color>
    <Color x:Key="TextMuted">#6E6A62</Color>

    <!-- Bordas -->
    <Color x:Key="BorderSoft">#26262C</Color>
    <Color x:Key="BorderGold">#4A3D24</Color>

</ResourceDictionary>