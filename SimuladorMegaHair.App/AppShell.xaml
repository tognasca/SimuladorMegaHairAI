<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:SimuladorMegaHair.App.Views"
       x:Class="SimuladorMegaHair.App.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <ShellContent Title="Início"
                  ContentTemplate="{DataTemplate views:HomePage}"
                  Route="HomePage" />

    <ShellContent Title="Captura"
                  ContentTemplate="{DataTemplate views:CapturePage}"
                  Route="CapturePage" />

    <ShellContent Title="Estilo"
                  ContentTemplate="{DataTemplate views:StyleSelectionPage}"
                  Route="StyleSelectionPage" />

    <ShellContent Title="Resultado"
                  ContentTemplate="{DataTemplate views:ResultPage}"
                  Route="ResultPage" />

    <ShellContent Title="Orçamento"
                  ContentTemplate="{DataTemplate views:BudgetPage}"
                  Route="BudgetPage" />
</Shell>