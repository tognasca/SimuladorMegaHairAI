<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SimuladorMegaHair.App.ViewModels"
             x:Class="SimuladorMegaHair.App.Views.CapturePage"
             x:DataType="vm:CaptureViewModel"
             BackgroundColor="{StaticResource PageBackgroundColor}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto" Padding="40,30">

        <!-- CABEÇALHO -->
        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,10,0,25">
            <Label Text="✦"
                   FontSize="24"
                   TextColor="{StaticResource GoldPrimary}"
                   HorizontalOptions="Center" />

            <Label Text="CAPTURE SUA FOTO"
                   FontSize="22"
                   FontAttributes="Bold"
                   CharacterSpacing="6"
                   TextColor="{StaticResource GoldPrimary}"
                   HorizontalOptions="Center" />

            <Label Text="Boa iluminação • Cabelo preso • Olhar para frente"
                   FontSize="12"
                   CharacterSpacing="2"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- ÁREA DA FOTO -->
        <Border Grid.Row="1"
                Stroke="{StaticResource GoldPrimary}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="{StaticResource CardColor}"
                Padding="0"
                Margin="0,10">
            <Grid>
                <Image Source="{Binding FotoPath}"
                       Aspect="AspectFit" />

                <!-- Placeholder quando não tem foto -->
                <VerticalStackLayout IsVisible="{Binding TemFoto, Converter={StaticResource InverseBoolConverter}}"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="12">
                    <Label Text="◈"
                           FontSize="55"
                           TextColor="{StaticResource GoldSoft}"
                           HorizontalOptions="Center"
                           Opacity="0.4" />
                    <Label Text="Aguardando captura"
                           FontSize="13"
                           CharacterSpacing="2"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- BOTÕES -->
        <VerticalStackLayout Grid.Row="2" Spacing="12" Margin="0,25,0,10">

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <!-- Botão Câmera -->
                <Border Grid.Column="0"
                        Stroke="{StaticResource GoldPrimary}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 28"
                        BackgroundColor="Transparent"
                        HeightRequest="55">
                    <Grid>
                        <Label FontSize="14"
                               FontAttributes="Bold"
                               CharacterSpacing="3"
                               TextColor="{StaticResource GoldPrimary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Text="📷  CÂMERA" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TirarFotoCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- Botão Galeria -->
                <Border Grid.Column="1"
                        Stroke="{StaticResource BorderSoft}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 28"
                        BackgroundColor="{StaticResource CardColor}"
                        HeightRequest="55">
                    <Grid>
                        <Label FontSize="14"
                               FontAttributes="Bold"
                               CharacterSpacing="3"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Text="🖼  GALERIA" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelecionarDaGaleriaCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>
            </Grid>

            <!-- Botão Avançar -->
            <Border Stroke="{StaticResource GoldPrimary}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 30"
                    BackgroundColor="{StaticResource GoldPrimary}"
                    HeightRequest="60"
                    Margin="0,5,0,0">
                <Grid>
                    <Label FontSize="15"
                           FontAttributes="Bold"
                           CharacterSpacing="5"
                           TextColor="#0A0A0C"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Text="AVANÇAR   →" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AvancarCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>