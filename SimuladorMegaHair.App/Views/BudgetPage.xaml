<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SimuladorMegaHair.App.ViewModels"
             x:Class="SimuladorMegaHair.App.Views.BudgetPage"
             x:DataType="vm:BudgetViewModel"
             BackgroundColor="{StaticResource PageBackgroundColor}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="40" Spacing="30" VerticalOptions="Center" MaximumWidthRequest="600" HorizontalOptions="Center">

            <Label Text="✦"
                   FontSize="40"
                   TextColor="{StaticResource GoldPrimary}"
                   HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="6">
                <Label Text="ORÇAMENTO GERADO"
                       FontSize="22"
                       FontAttributes="Bold"
                       CharacterSpacing="6"
                       TextColor="{StaticResource GoldPrimary}"
                       HorizontalOptions="Center" />

                <Label Text="Sua nova versão está pronta"
                       FontSize="12"
                       CharacterSpacing="2"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Border Stroke="{StaticResource GoldPrimary}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 15"
                    BackgroundColor="{StaticResource CardColor}"
                    Padding="35">

                <VerticalStackLayout Spacing="20">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="MÉTODO"
                               FontSize="10"
                               CharacterSpacing="3"
                               TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding Metodo}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource BorderSoft}" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="COMPRIMENTO"
                               FontSize="10"
                               CharacterSpacing="3"
                               TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding Comprimento}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource BorderSoft}" />

                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="VALOR TOTAL"
                               FontSize="10"
                               CharacterSpacing="3"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center" />
                        <Label FontSize="50"
                               FontAttributes="Bold"
                               TextColor="{StaticResource GoldPrimary}"
                               HorizontalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="R$ " FontSize="28" />
                                    <Span Text="{Binding ValorEstimado, StringFormat='{0:N2}'}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>

                    <Label Text="* Valor sujeito a avaliação presencial"
                           FontSize="10"
                           CharacterSpacing="1"
                           FontAttributes="Italic"
                           TextColor="{StaticResource TextMuted}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="{StaticResource GoldPrimary}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 30"
                    BackgroundColor="{StaticResource GoldPrimary}"
                    HeightRequest="55">
                <Grid>
                    <Label Text="VOLTAR AO INÍCIO"
                           FontSize="13"
                           FontAttributes="Bold"
                           CharacterSpacing="5"
                           TextColor="#0A0A0C"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VoltarInicioCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>