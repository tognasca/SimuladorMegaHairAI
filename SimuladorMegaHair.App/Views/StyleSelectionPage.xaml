<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SimuladorMegaHair.App.ViewModels"
             xmlns:layouts="clr-namespace:SimuladorMegaHair.App.Views.Layouts"
             x:Class="SimuladorMegaHair.App.Views.StyleSelectionPage"
             x:Name="PageRoot"
             x:DataType="vm:StyleSelectionViewModel"
             BackgroundColor="{StaticResource PageBackgroundColor}"
             Shell.NavBarIsVisible="False">

    <!--
        ═══════════════════════════════════════════════════════════
        TELA RESPONSIVA: alterna entre layout Vertical (TV montada em
        pé / tablet e celular em pé) e Horizontal (TV deitada / desktop)
        automaticamente, com base em IsPortrait / IsLandscape do
        ViewModel — recalculados a cada rotação/redimensionamento em
        StyleSelectionPage.xaml.cs (OnPageSizeChanged → AtualizarLayout).

        O usuário também pode forçar um modo fixo em Configurações
        (LayoutModeSelected: "Automático" | "Vertical" | "Horizontal"),
        útil para a TV do salão que fica sempre montada do mesmo jeito
        e não precisa "adivinhar" a orientação a cada carregamento.
        ═══════════════════════════════════════════════════════════
    -->
    <Grid>
        <layouts:PortraitExperienceView IsVisible="{Binding IsPortrait}" />
        <layouts:LandscapeExperienceView IsVisible="{Binding IsLandscape}" />
    </Grid>
</ContentPage>
