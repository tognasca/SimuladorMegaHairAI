<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SimuladorMegaHair.App.ViewModels"
             xmlns:components="clr-namespace:SimuladorMegaHair.App.Views.Components"
             xmlns:models="clr-namespace:SimuladorMegaHair.App.Models"
             x:Class="SimuladorMegaHair.App.Views.StyleSelectionPage"
             x:Name="PageRoot"
             x:DataType="vm:StyleSelectionViewModel"
             BackgroundColor="{StaticResource PageBackgroundColor}"
             Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="220, *, 340" RowDefinitions="Auto, *, Auto">

        <!-- SIDEBAR -->
        <components:SidebarMenu Grid.RowSpan="3" Grid.Column="0" />

        <!-- CABEÇALHO -->
        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Padding="30,20,30,10">
            <Label Text="SUA NOVA VERSÃO"
                   FontSize="20"
                   CharacterSpacing="6"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- ÁREA PRINCIPAL - FOTO -->
        <!-- ═══ ÁREA PRINCIPAL: FOTO + HISTÓRICO ═══ -->
        <Grid Grid.Row="1" Grid.Column="1"
      RowDefinitions="Auto, *, Auto"
      Margin="30,0,15,20">

            <!-- ═══ SELETOR DE MODO (Antes / Slider / Depois) ═══ -->
            <Border Grid.Row="0"
            Padding="4"
            HorizontalOptions="Center"
            StrokeShape="RoundRectangle 25"
            BackgroundColor="{StaticResource CardColor}"
            Stroke="{StaticResource BorderSoft}"
            StrokeThickness="1"
            Margin="0,0,0,15"
            IsVisible="{Binding TemResultado}">
                <Grid ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="4">

                    <!-- ANTES -->
                    <Border Grid.Column="0"
                    Padding="16,8"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ModoAntes}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource GoldPrimary}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding ModoAntes}" Value="False">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="ANTES"
                       FontSize="10"
                       FontAttributes="Bold"
                       CharacterSpacing="2"
                       VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ModoAntes}" Value="True">
                                    <Setter Property="TextColor" Value="#0A0A0C" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding ModoAntes}" Value="False">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MudarModoCommand}" CommandParameter="Antes" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- SLIDER (comparador) -->
                    <Border Grid.Column="1"
                    Padding="16,8"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ModoSlider}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource GoldPrimary}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding ModoSlider}" Value="False">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="⇔ COMPARAR"
                       FontSize="10"
                       FontAttributes="Bold"
                       CharacterSpacing="2"
                       VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ModoSlider}" Value="True">
                                    <Setter Property="TextColor" Value="#0A0A0C" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding ModoSlider}" Value="False">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MudarModoCommand}" CommandParameter="Slider" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- DEPOIS -->
                    <Border Grid.Column="2"
                    Padding="16,8"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ModoDepois}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource GoldPrimary}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding ModoDepois}" Value="False">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="DEPOIS"
                       FontSize="10"
                       FontAttributes="Bold"
                       CharacterSpacing="2"
                       VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ModoDepois}" Value="True">
                                    <Setter Property="TextColor" Value="#0A0A0C" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding ModoDepois}" Value="False">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MudarModoCommand}" CommandParameter="Depois" />
                        </Border.GestureRecognizers>
                    </Border>

                </Grid>
            </Border>

            <!-- ═══ MOLDURA DA FOTO ═══ -->
            <Border Grid.Row="1"
            Stroke="{StaticResource GoldPrimary}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 20"
            BackgroundColor="{StaticResource CardColor}"
            Padding="0">
                <Grid>

                    <!-- SEM RESULTADO: mostra só a foto original -->
                    <Image Source="{Binding FotoExibicao}"
                   Aspect="AspectFit"
                   IsVisible="{Binding TemResultado, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- COM RESULTADO: 3 modos -->

                    <!-- Modo ANTES -->
                    <Image Source="{Binding FotoExibicao}"
                   Aspect="AspectFit"
                   IsVisible="{Binding ModoAntes}" />

                    <!-- Modo DEPOIS -->
                    <Image Source="{Binding FotoResultadoUrl}"
                   Aspect="AspectFit"
                   IsVisible="{Binding ModoDepois}" />

                    <!-- Modo SLIDER COMPARADOR -->
                    <components:BeforeAfterSlider
                BeforeSource="{Binding FotoExibicao}"
                AfterSource="{Binding FotoResultadoUrl}"
                IsVisible="{Binding ModoSlider}" />

                </Grid>
            </Border>

            <!-- ═══ HISTÓRICO DE SIMULAÇÕES ═══ -->
            <Border Grid.Row="2"
            Margin="0,15,0,0"
            Padding="15"
            BackgroundColor="{StaticResource CardColor}"
            Stroke="{StaticResource BorderSoft}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 15"
            IsVisible="{Binding TemHistorico}">

                <VerticalStackLayout Spacing="10">

                    <!-- Cabeçalho -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Label Text="📸"
                       FontSize="14"
                       VerticalOptions="Center" />
                        <Label Grid.Column="1"
                       Text="SUAS SIMULAÇÕES"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="3"
                       TextColor="White"
                       VerticalOptions="Center"
                       Margin="10,0,0,0" />
                        <Label Grid.Column="2"
                       Text="{Binding Historico.Count, StringFormat='{0} salvas'}"
                       FontSize="10"
                       TextColor="{StaticResource TextMuted}"
                       VerticalOptions="Center" />
                    </Grid>

                    <!-- Scroll horizontal -->
                    <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="10"
                                       BindableLayout.ItemsSource="{Binding Historico}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:SimulacaoResponse">
                                    <Border WidthRequest="90"
                                    HeightRequest="120"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="{StaticResource BorderSoft}"
                                    StrokeThickness="1"
                                    BackgroundColor="#1A1A20"
                                    Padding="0">
                                        <Grid RowDefinitions="*, Auto">
                                            <Image Grid.Row="0"
                                           Source="{Binding FotoResultadoUrl}"
                                           Aspect="AspectFill" />
                                            <Border Grid.Row="1"
                                            BackgroundColor="#0A0A0C"
                                            Padding="5,4">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label Text="{Binding Comprimento}"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource GoldPrimary}"
                                                   HorizontalOptions="Center" />
                                                    <Label Text="{Binding Cor}"
                                                   FontSize="8"
                                                   TextColor="White"
                                                   HorizontalOptions="Center" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                        Command="{Binding BindingContext.SelecionarDoHistoricoCommand, Source={x:Reference PageRoot}}"
                                        CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                </VerticalStackLayout>
            </Border>

        </Grid>

        <!-- PAINEL DIREITO (CONTROLES) -->
        <ScrollView Grid.Row="1" Grid.Column="2" Padding="15,0,25,0">
            <VerticalStackLayout Spacing="20">

                <!-- PAINEL DE PERSONALIZAÇÃO -->
                <Border BackgroundColor="{StaticResource CardColor}"
        Stroke="#202025"
        Padding="20"
        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="20">

                        <!-- HEADER -->
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Text="⟡"
                   FontSize="20"
                   TextColor="{StaticResource GoldPrimary}"
                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                   Text="MEGA HAIR"
                   FontSize="16"
                   FontAttributes="Bold"
                   CharacterSpacing="4"
                   TextColor="White"
                   VerticalOptions="Center"
                   Margin="10,0,0,0" />
                        </Grid>

                        <!-- ═══════════════ COMPRIMENTO ═══════════════ -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="COMPRIMENTO"
                   FontSize="10"
                   CharacterSpacing="2"
                   TextColor="{StaticResource TextSecondary}" />

                            <FlexLayout Wrap="Wrap" Direction="Row"
                        BindableLayout.ItemsSource="{Binding ComprimentosLista}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Padding="15,10"
                                Margin="0,0,8,8"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="2">
                                            <Border.Stroke>
                                                <MultiBinding Converter="{StaticResource SelectionConverter}"
                                              ConverterParameter="Stroke">
                                                    <Binding Path="." />
                                                    <Binding Path="BindingContext.ComprimentoSelecionado"
                                             Source="{x:Reference PageRoot}" />
                                                </MultiBinding>
                                            </Border.Stroke>
                                            <Border.BackgroundColor>
                                                <MultiBinding Converter="{StaticResource SelectionConverter}"
                                              ConverterParameter="Background">
                                                    <Binding Path="." />
                                                    <Binding Path="BindingContext.ComprimentoSelecionado"
                                             Source="{x:Reference PageRoot}" />
                                                </MultiBinding>
                                            </Border.BackgroundColor>

                                            <Label Text="{Binding .}"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                                <Label.TextColor>
                                                    <MultiBinding Converter="{StaticResource SelectionConverter}"
                                                  ConverterParameter="Text">
                                                        <Binding Path="." />
                                                        <Binding Path="BindingContext.ComprimentoSelecionado"
                                                 Source="{x:Reference PageRoot}" />
                                                    </MultiBinding>
                                                </Label.TextColor>
                                            </Label>

                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.SelectComprimentoCommand, Source={x:Reference PageRoot}}"
                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- ═══════════════ COR ═══════════════ -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="COR"
                   FontSize="10"
                   CharacterSpacing="2"
                   TextColor="{StaticResource TextSecondary}" />

                            <FlexLayout Wrap="Wrap" Direction="Row"
                        BindableLayout.ItemsSource="{Binding CoresLista}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <!-- Grid envelopa: 1 anel de borda + 1 círculo interno -->
                                        <Grid WidthRequest="46" HeightRequest="46"
                              Margin="0,0,10,8">
                                            <!-- ANEL EXTERNO (borda dourada quando selecionado) -->
                                            <Ellipse WidthRequest="46" HeightRequest="46"
                                     StrokeThickness="3"
                                     Fill="Transparent">
                                                <Ellipse.Stroke>
                                                    <MultiBinding Converter="{StaticResource SelectionConverter}"
                                                  ConverterParameter="Stroke">
                                                        <Binding Path="." />
                                                        <Binding Path="BindingContext.CorSelecionada"
                                                 Source="{x:Reference PageRoot}" />
                                                    </MultiBinding>
                                                </Ellipse.Stroke>
                                            </Ellipse>

                                            <!-- CÍRCULO DA COR -->
                                            <Ellipse WidthRequest="34" HeightRequest="34"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Fill="{Binding ., Converter={StaticResource StringToColorConverter}}" />

                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.SelectCorCommand, Source={x:Reference PageRoot}}"
                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- ═══════════════ TIPO DE FIO ═══════════════ -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="TIPO DE FIO"
                   FontSize="10"
                   CharacterSpacing="2"
                   TextColor="{StaticResource TextSecondary}" />

                            <FlexLayout Wrap="Wrap" Direction="Row"
                        BindableLayout.ItemsSource="{Binding TiposLista}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Padding="15,10"
                                Margin="0,0,8,8"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="2">
                                            <Border.Stroke>
                                                <MultiBinding Converter="{StaticResource SelectionConverter}"
                                              ConverterParameter="Stroke">
                                                    <Binding Path="." />
                                                    <Binding Path="BindingContext.TipoCabeloSelecionado"
                                             Source="{x:Reference PageRoot}" />
                                                </MultiBinding>
                                            </Border.Stroke>
                                            <Border.BackgroundColor>
                                                <MultiBinding Converter="{StaticResource SelectionConverter}"
                                              ConverterParameter="Background">
                                                    <Binding Path="." />
                                                    <Binding Path="BindingContext.TipoCabeloSelecionado"
                                             Source="{x:Reference PageRoot}" />
                                                </MultiBinding>
                                            </Border.BackgroundColor>

                                            <Label Text="{Binding .}"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                                <Label.TextColor>
                                                    <MultiBinding Converter="{StaticResource SelectionConverter}"
                                                  ConverterParameter="Text">
                                                        <Binding Path="." />
                                                        <Binding Path="BindingContext.TipoCabeloSelecionado"
                                                 Source="{x:Reference PageRoot}" />
                                                    </MultiBinding>
                                                </Label.TextColor>
                                            </Label>

                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.SelectTipoCommand, Source={x:Reference PageRoot}}"
                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- ═══════════════ MÉTODO ═══════════════ -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="MÉTODO"
                   FontSize="10"
                   CharacterSpacing="2"
                   TextColor="{StaticResource TextSecondary}" />

                            <FlexLayout Wrap="Wrap" Direction="Row"
                        BindableLayout.ItemsSource="{Binding MetodosLista}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Padding="15,10"
                                Margin="0,0,8,8"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="2">
                                            <Border.Stroke>
                                                <MultiBinding Converter="{StaticResource SelectionConverter}"
                                              ConverterParameter="Stroke">
                                                    <Binding Path="." />
                                                    <Binding Path="BindingContext.MetodoSelecionado"
                                             Source="{x:Reference PageRoot}" />
                                                </MultiBinding>
                                            </Border.Stroke>
                                            <Border.BackgroundColor>
                                                <MultiBinding Converter="{StaticResource SelectionConverter}"
                                              ConverterParameter="Background">
                                                    <Binding Path="." />
                                                    <Binding Path="BindingContext.MetodoSelecionado"
                                             Source="{x:Reference PageRoot}" />
                                                </MultiBinding>
                                            </Border.BackgroundColor>

                                            <Label Text="{Binding .}"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                                <Label.TextColor>
                                                    <MultiBinding Converter="{StaticResource SelectionConverter}"
                                                  ConverterParameter="Text">
                                                        <Binding Path="." />
                                                        <Binding Path="BindingContext.MetodoSelecionado"
                                                 Source="{x:Reference PageRoot}" />
                                                    </MultiBinding>
                                                </Label.TextColor>
                                            </Label>

                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.SelectMetodoCommand, Source={x:Reference PageRoot}}"
                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Debug -->
                        <VerticalStackLayout Spacing="3" Margin="0,10,0,0">
                            <Label Text="Selecionado:" FontSize="9" TextColor="{StaticResource TextMuted}" />
                            <Label Text="{Binding ComprimentoSelecionado, StringFormat='Comprimento: {0}'}" FontSize="10" TextColor="{StaticResource GoldPrimary}" />
                            <Label Text="{Binding CorSelecionada,          StringFormat='Cor: {0}'}"          FontSize="10" TextColor="{StaticResource GoldPrimary}" />
                            <Label Text="{Binding TipoCabeloSelecionado,   StringFormat='Tipo: {0}'}"         FontSize="10" TextColor="{StaticResource GoldPrimary}" />
                            <Label Text="{Binding MetodoSelecionado,       StringFormat='Método: {0}'}"       FontSize="10" TextColor="{StaticResource GoldPrimary}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- BOTÃO GERAR -->
                <Border Stroke="{StaticResource GoldPrimary}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 25"
                        BackgroundColor="{StaticResource GoldPrimary}"
                        HeightRequest="50">
                    <Label Text="GERAR SIMULAÇÃO"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#0A0A0C"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GerarSimulacaoCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- ORÇAMENTO -->
                <Border BackgroundColor="{StaticResource CardColor}"
                        Stroke="{StaticResource BorderSoft}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 15"
                        Padding="20"
                        IsVisible="{Binding TemResultado}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="VALOR ESTIMADO"
                               FontSize="10"
                               CharacterSpacing="3"
                               TextColor="{StaticResource TextSecondary}" />
                        <Label Text="{Binding ValorAtual, StringFormat='R$ {0:N2}'}"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="{StaticResource GoldPrimary}" />
                        <Border Stroke="{StaticResource GoldPrimary}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 25"
                                BackgroundColor="{StaticResource GoldPrimary}"
                                HeightRequest="45"
                                Margin="0,10,0,0">
                            <Label Text="AGENDAR AGORA"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#0A0A0C"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding VerOrcamentoCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>