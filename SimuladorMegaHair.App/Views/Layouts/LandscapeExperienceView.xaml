<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SimuladorMegaHair.App.ViewModels"
    xmlns:models="clr-namespace:SimuladorMegaHair.App.Models"
    xmlns:components="clr-namespace:SimuladorMegaHair.App.Views.Components"
    x:Class="SimuladorMegaHair.App.Views.Layouts.LandscapeExperienceView"
    x:Name="RootView"
    x:DataType="vm:StyleSelectionViewModel">

    <ContentView.Resources>
        <Color x:Key="GoldActive">#D4A143</Color>
        <Color x:Key="TextActive">#0A0A0C</Color>
        <Color x:Key="TextInactive">#FFFFFF</Color>

        <Style x:Key="VolumeBtnBase" TargetType="Border">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Stroke" Value="#2A2B30" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="VolumeLabelBase" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="0.5" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="#8F9199" />
        </Style>
    </ContentView.Resources>

    <!-- Grid raiz: conteúdo + overlay de loading -->
    <Grid>

        <!-- ═══════════════ CONTEÚDO PRINCIPAL ═══════════════ -->
        <Grid
            BackgroundColor="#08090B"
            RowDefinitions="Auto,*,Auto"
            ColumnDefinitions="220,*,380">

            <!-- ═══ MENU LATERAL ═══ -->
            <Border
                Grid.RowSpan="3"
                Grid.Column="0"
                BackgroundColor="#0B0D10"
                Stroke="#292A2E"
                Padding="20">

                <VerticalStackLayout Spacing="24">
                    <Image Source="logo_tati.png"
                           HeightRequest="120"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />

                    <Label Text="⌂   INÍCIO"        TextColor="White" FontSize="14" />
                    <Label Text="✧   SIMULAÇÃO"     TextColor="White" FontSize="14" />
                    <Label Text="▣   CATÁLOGO"      TextColor="White" FontSize="14" />
                    <Label Text="♙   CLIENTES"      TextColor="White" FontSize="14" />
                    <Label Text="▤   ORÇAMENTOS"    TextColor="White" FontSize="14" />
                    <Label Text="⚙   CONFIGURAÇÕES" TextColor="White" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <!-- ═══ CABEÇALHO ═══ -->
            <Grid
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Grid.Row="0"
                Padding="25,18">

                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label
                        Text="SUA NOVA VERSÃO"
                        FontSize="24"
                        CharacterSpacing="6"
                        TextColor="#F5EEE4"
                        HorizontalOptions="Center" />

                    <!-- Selo de cliente vinculado -->
                    <Border IsVisible="{Binding TemClienteVinculado}"
                            StrokeShape="RoundRectangle 12"
                            Stroke="#80602F"
                            BackgroundColor="#151619"
                            Padding="12,5"
                            HorizontalOptions="Center">
                        <Label FontSize="11" TextColor="#E4C187">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="♙ Para: " />
                                    <Span Text="{Binding ClienteNome}" FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- ═══ ÁREA PRINCIPAL: SELETOR + FOTO + VOLUME + HISTÓRICO ═══ -->
            <Grid
                Grid.Row="1"
                Grid.Column="1"
                Margin="18"
                RowDefinitions="Auto,*,Auto,Auto">

                <!-- SELETOR DE MODO -->
                <Border Grid.Row="0"
                        Padding="4"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 25"
                        BackgroundColor="#111316"
                        Stroke="#292A2E"
                        StrokeThickness="1"
                        Margin="0,0,0,12"
                        IsVisible="{Binding TemResultado}">

                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="4">

                        <!-- ANTES -->
                        <Border Grid.Column="0"
                                Padding="18,10"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding ModoAntes}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#C89442" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding ModoAntes}" Value="False">
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="ANTES"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="3"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ModoAntes}" Value="True">
                                        <Setter Property="TextColor" Value="#0A0A0C" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding ModoAntes}" Value="False">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding MudarModoCommand}" CommandParameter="Antes" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- COMPARAR -->
                        <Border Grid.Column="1"
                                Padding="18,10"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding ModoSlider}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#C89442" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding ModoSlider}" Value="False">
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="⇔  COMPARAR"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="3"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ModoSlider}" Value="True">
                                        <Setter Property="TextColor" Value="#0A0A0C" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding ModoSlider}" Value="False">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding MudarModoCommand}" CommandParameter="Slider" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- DEPOIS -->
                        <Border Grid.Column="2"
                                Padding="18,10"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding ModoDepois}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#C89442" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding ModoDepois}" Value="False">
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="DEPOIS"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="3"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ModoDepois}" Value="True">
                                        <Setter Property="TextColor" Value="#0A0A0C" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding ModoDepois}" Value="False">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding MudarModoCommand}" CommandParameter="Depois" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </Border>

                <!-- MOLDURA DA FOTO -->
                <Border Grid.Row="1"
                        Stroke="#80602F"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#111316">

                    <Grid>
                        <!-- Sem resultado -->
                        <Image
                            Source="{Binding FotoExibicao}"
                            Aspect="AspectFit"
                            IsVisible="{Binding TemResultado, Converter={StaticResource InverseBoolConverter}}" />

                        <!-- Caixa de resultados -->
                        <Grid IsVisible="{Binding TemResultado}">

                            <Image
                                Source="{Binding FotoExibicao}"
                                Aspect="AspectFit"
                                IsVisible="{Binding ModoAntes}" />

                            <!-- DEPOIS: usa volume se houver -->
                            <Image
                                Source="{Binding FotoVolumeAtiva}"
                                Aspect="AspectFit"
                                IsVisible="{Binding ModoDepois}" />

                            <components:BeforeAfterSlider
                                BeforeSource="{Binding FotoExibicao}"
                                AfterSource="{Binding FotoVolumeAtiva}"
                                IsVisible="{Binding ModoSlider}" />
                        </Grid>

                        <!-- Loading do volume -->
                        <BoxView Color="#000000"
                                 Opacity="0.55"
                                 IsVisible="{Binding AjustandoVolume}" />
                        <ActivityIndicator
                            IsRunning="{Binding AjustandoVolume}"
                            IsVisible="{Binding AjustandoVolume}"
                            Color="#D4A143"
                            HeightRequest="36"
                            WidthRequest="36"
                            VerticalOptions="Center"
                            HorizontalOptions="Center" />
                    </Grid>
                </Border>

                <!-- ═══ VOLUME MEGA HAIR (100–400g) ═══ -->
                <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        Padding="14,12"
                        BackgroundColor="#111316"
                        Stroke="#292A2E"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        IsVisible="{Binding TemResultado}">

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="💇‍♀️ VOLUME MEGA HAIR"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                CharacterSpacing="1"
                                                TextColor="#FFFFFF" />
                                    <Label Text="Ajuste a densidade do seu novo cabelo"
                                                FontSize="10"
                                                TextColor="#6B6D74" />              
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    Padding="10,6"
                                    BackgroundColor="#1A1D24"
                                    StrokeShape="RoundRectangle 12"
                                    VerticalOptions="Center">
                                <Label Text="{Binding GramasAtuais, StringFormat='{0}g'}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#D4A143"
                                       HorizontalOptions="Center" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">

                            <!-- 100g -->
                            <Border Grid.Column="0" Style="{StaticResource VolumeBtnBase}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding VolumeNivel}" Value="1">
                                        <Setter Property="BackgroundColor" Value="{StaticResource GoldActive}" />
                                        <Setter Property="Stroke" Value="{StaticResource GoldActive}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="100g" Style="{StaticResource VolumeLabelBase}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding VolumeNivel}" Value="1">
                                                <Setter Property="TextColor" Value="{StaticResource TextActive}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="Natural" FontSize="8" TextColor="#555760" HorizontalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding VolumeNivel}" Value="1">
                                                <Setter Property="TextColor" Value="#0A0A0C" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AjustarVolumeCommand}" CommandParameter="1" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- 200g -->
                            <Border Grid.Column="1" Style="{StaticResource VolumeBtnBase}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding VolumeNivel}" Value="2">
                                        <Setter Property="BackgroundColor" Value="{StaticResource GoldActive}" />
                                        <Setter Property="Stroke" Value="{StaticResource GoldActive}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="200g" Style="{StaticResource VolumeLabelBase}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding VolumeNivel}" Value="2">
                                                <Setter Property="TextColor" Value="{StaticResource TextActive}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="Cheio" FontSize="8" TextColor="#555760" HorizontalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding VolumeNivel}" Value="2">
                                                <Setter Property="TextColor" Value="#0A0A0C" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AjustarVolumeCommand}" CommandParameter="2" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- 300g -->
                            <Border Grid.Column="2" Style="{StaticResource VolumeBtnBase}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding VolumeNivel}" Value="3">
                                        <Setter Property="BackgroundColor" Value="{StaticResource GoldActive}" />
                                        <Setter Property="Stroke" Value="{StaticResource GoldActive}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="300g" Style="{StaticResource VolumeLabelBase}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding VolumeNivel}" Value="3">
                                                <Setter Property="TextColor" Value="{StaticResource TextActive}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="Extra" FontSize="8" TextColor="#555760" HorizontalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding VolumeNivel}" Value="3">
                                                <Setter Property="TextColor" Value="#0A0A0C" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AjustarVolumeCommand}" CommandParameter="3" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- 400g -->
                            <Border Grid.Column="3" Style="{StaticResource VolumeBtnBase}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding VolumeNivel}" Value="4">
                                        <Setter Property="BackgroundColor" Value="{StaticResource GoldActive}" />
                                        <Setter Property="Stroke" Value="{StaticResource GoldActive}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="400g" Style="{StaticResource VolumeLabelBase}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding VolumeNivel}" Value="4">
                                                <Setter Property="TextColor" Value="{StaticResource TextActive}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="Máximo" FontSize="8" TextColor="#555760" HorizontalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding VolumeNivel}" Value="4">
                                                <Setter Property="TextColor" Value="#0A0A0C" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AjustarVolumeCommand}" CommandParameter="4" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- HISTÓRICO -->
                <Border Grid.Row="3"
                        Margin="0,12,0,0"
                        Padding="15"
                        BackgroundColor="#111316"
                        Stroke="#292A2E"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 15"
                        IsVisible="{Binding TemHistorico}">

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Text="📸" FontSize="14" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="SUAS SIMULAÇÕES"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="3"
                                   TextColor="White"
                                   VerticalOptions="Center"
                                   Margin="10,0,0,0" />
                            <Label Grid.Column="2"
                                   Text="{Binding Historico.Count, StringFormat='{0} salvas'}"
                                   FontSize="10"
                                   TextColor="#A9A5A0"
                                   VerticalOptions="Center" />
                        </Grid>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="10"
                                                   BindableLayout.ItemsSource="{Binding Historico}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:SimulacaoResponse">
                                        <Border WidthRequest="90"
                                                HeightRequest="120"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="#292A2E"
                                                StrokeThickness="1"
                                                BackgroundColor="#1A1D2A"
                                                Padding="0">
                                            <Grid RowDefinitions="*,Auto">
                                                <Image Grid.Row="0"
                                                       Source="{Binding FotoResultadoUrl}"
                                                       Aspect="AspectFill" />
                                                <Border Grid.Row="1" BackgroundColor="#0A0A0C" Padding="5,4">
                                                    <VerticalStackLayout Spacing="1">
                                                        <Label Text="{Binding Comprimento}"
                                                               FontSize="9"
                                                               FontAttributes="Bold"
                                                               TextColor="#E4C187"
                                                               HorizontalOptions="Center" />
                                                        <Label Text="{Binding Cor}"
                                                               FontSize="8"
                                                               TextColor="White"
                                                               HorizontalOptions="Center" />
                                                    </VerticalStackLayout>
                                                </Border>
                                            </Grid>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.SelecionarDoHistoricoCommand, Source={x:Reference RootView}}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ═══ PAINEL DIREITO ═══ -->
            <ScrollView
                Grid.Row="1"
                Grid.Column="2"
                Padding="10,18,18,18">

                <VerticalStackLayout Spacing="16">

                    <Label Text="MEGA HAIR" FontSize="22" TextColor="#E4C187" />

                    <Label Text="COMPRIMENTO" FontSize="11" TextColor="#A9A5A0" />
                    <Picker
                        ItemsSource="{Binding Comprimentos}"
                        SelectedItem="{Binding ComprimentoSelecionado}"
                        TextColor="White"
                        TitleColor="#77788B"
                        BackgroundColor="#1A1D2A" />

                    <Label Text="COR" FontSize="11" TextColor="#A9A5A0" />
                    <Picker
                        ItemsSource="{Binding Cores}"
                        SelectedItem="{Binding CorSelecionada}"
                        TextColor="White"
                        TitleColor="#77788B"
                        BackgroundColor="#1A1D2A" />

                    <Label Text="TIPO DE FIO" FontSize="11" TextColor="#A9A5A0" />
                    <Picker
                        ItemsSource="{Binding TiposCabelo}"
                        SelectedItem="{Binding TipoCabeloSelecionado}"
                        TextColor="White"
                        TitleColor="#77788B"
                        BackgroundColor="#1A1D2A" />

                    <Label Text="MÉTODO" FontSize="11" TextColor="#A9A5A0" />
                    <Picker
                        ItemsSource="{Binding Metodos}"
                        SelectedItem="{Binding MetodoSelecionado}"
                        TextColor="White"
                        TitleColor="#77788B"
                        BackgroundColor="#1A1D2A" />

                    <!-- RESUMO DE VOLUME NO PAINEL DIREITO -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding TemResultado}">
                        <Label Text="VOLUME SELECIONADO" FontSize="11" TextColor="#A9A5A0" />
                        <Label Text="{Binding GramasAtuais, StringFormat='{0}g de Mega Hair'}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#D4A143" />
                        <Label Text="{Binding VolumeTexto}"
                               FontSize="10"
                               TextColor="#6B6D74" />
                    </VerticalStackLayout>

                    <Button
                        Text="CRIAR VISUAL"
                        FontAttributes="Bold"
                        BackgroundColor="#C89442"
                        TextColor="White"
                        HeightRequest="55"
                        CornerRadius="27"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        Command="{Binding GerarSimulacaoCommand}" />

                    <Label
                        Text="VALOR ESTIMADO"
                        FontSize="11"
                        TextColor="#A9A5A0"
                        IsVisible="{Binding TemResultado}" />

                    <Label
                        Text="{Binding ValorAtual, StringFormat='R$ {0:N2}'}"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="#E4C187"
                        IsVisible="{Binding TemResultado}" />

                    <Button
                        Text="AGENDAR"
                        BackgroundColor="#C89442"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="25"
                        IsVisible="{Binding TemResultado}"
                        Command="{Binding VerOrcamentoCommand}" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- ═══ RODAPÉ ═══ -->
            <Grid
                Grid.Row="2"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Padding="20"
                ColumnDefinitions="*,*,*,*">

                <Label Text="SIMULAÇÃO REALISTA" TextColor="#D8B27A" HorizontalOptions="Center" />
                <Label Grid.Column="1" Text="TEMPO REAL" TextColor="#D8B27A" HorizontalOptions="Center" />
                <Label Grid.Column="2" Text="TECNOLOGIA TATIANE TOGNASCA" TextColor="#D8B27A" HorizontalOptions="Center" />
                <Label Grid.Column="3" Text="SEGURO E PRIVADO" TextColor="#D8B27A" HorizontalOptions="Center" />
            </Grid>
        </Grid>

        <!-- Overlay de loading geral -->
        <components:LoadingOverlay IsLoading="{Binding IsBusy}" />
    </Grid>
</ContentView>