<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SimuladorMegaHair.App.ViewModels"
             x:Class="SimuladorMegaHair.App.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             BackgroundColor="{StaticResource PageBackgroundColor}"
             Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="26"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Padding="40,50">

                <!-- ═══ LOGO TATI MEGA HAIR ═══ -->
                <Image Source="logo_tati.png"
                       HeightRequest="180"
                       MaximumHeightRequest="200"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       Margin="0,-10,0,0"/>

                <!-- Divisor dourado -->
                <BoxView HeightRequest="1"
                         WidthRequest="80"
                         Color="{StaticResource GoldPrimary}"
                         HorizontalOptions="Center"
                         Opacity="0.5" />

                <!-- Subtítulo -->
                <Label Text="O que você quer fazer agora?"
                       FontSize="15"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center"
                       LineHeight="1.4" />

                <!-- ═══ MENU DE OPÇÕES ═══ -->
                <VerticalStackLayout Spacing="14" WidthRequest="320">

                    <!-- Nova Simulação (destaque) -->
                    <Border Stroke="{StaticResource GoldPrimary}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource GoldPrimary}"
                            HeightRequest="72">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="20,0">
                            <Label Text="✦" FontSize="22" TextColor="#0A0A0C" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="NOVA SIMULAÇÃO" FontSize="15" FontAttributes="Bold" CharacterSpacing="2" TextColor="#0A0A0C" />
                                <Label Text="Tirar ou escolher uma foto" FontSize="11" TextColor="#0A0A0C" Opacity="0.75" />
                            </VerticalStackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding IniciarSimulacaoCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <!-- Buscar Cliente -->
                    <Border Stroke="{StaticResource BorderSoft}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource CardColor}"
                            HeightRequest="72">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="20,0">
                            <Label Text="♙" FontSize="20" TextColor="{StaticResource GoldPrimary}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="BUSCAR CLIENTE" FontSize="15" FontAttributes="Bold" CharacterSpacing="2" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Ver histórico de quem já simulou" FontSize="11" TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BuscarClienteCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <!-- Catálogo -->
                    <Border Stroke="{StaticResource BorderSoft}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource CardColor}"
                            HeightRequest="72">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="20,0">
                            <Label Text="▣" FontSize="20" TextColor="{StaticResource GoldPrimary}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="CATÁLOGO" FontSize="15" FontAttributes="Bold" CharacterSpacing="2" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Cabelos, cores e preços disponíveis" FontSize="11" TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AbrirCatalogoCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <!-- Orçamentos -->
                    <Border Stroke="{StaticResource BorderSoft}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource CardColor}"
                            HeightRequest="72">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="20,0">
                            <Label Text="▤" FontSize="20" TextColor="{StaticResource GoldPrimary}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="ORÇAMENTOS" FontSize="15" FontAttributes="Bold" CharacterSpacing="2" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Propostas e valores salvos" FontSize="11" TextColor="{StaticResource TextMuted}" />
                            </VerticalStackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AbrirOrcamentosCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- Rodapé -->
                <Label Text="Tecnologia Tatiane Tognasca • Simulação com IA"
                       FontSize="10"
                       CharacterSpacing="3"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,15,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Botão de Configurações -->
        <Border Stroke="{StaticResource BorderSoft}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 25"
                BackgroundColor="{StaticResource CardColor}"
                WidthRequest="50"
                HeightRequest="50"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="20">
            <Grid>
                <Label Text="⚙"
                       FontSize="20"
                       TextColor="{StaticResource GoldPrimary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirConfiguracoesCommand}" />
                </Grid.GestureRecognizers>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
