@page "/clientes"
@rendermode InteractiveServer
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Clientes</PageTitle>

<div style="max-width:700px; margin:0 auto; display:flex; flex-direction:column; gap:18px;">

    <div>
        <h2 style="letter-spacing:3px; font-size:22px; color:var(--gold); margin-bottom:4px;">CLIENTES</h2>
        <p style="color:var(--text-secondary); font-size:13px;">Busque um cliente já cadastrado ou crie um novo</p>
    </div>

    <div style="display:flex; gap:10px;">
        <input @bind="termoBusca" @bind:event="oninput" @onkeyup="OnKeyUp"
               placeholder="Buscar por nome, telefone ou e-mail..."
               style="flex:1; padding:12px 16px; border-radius:12px; background:var(--input); color:var(--text-primary); border:1px solid var(--border-soft);" />

        <button class="btn-gold" style="white-space:nowrap;" @onclick="() => mostrandoNovo = !mostrandoNovo">
            + NOVO
        </button>
    </div>

    @if (mostrandoNovo)
    {
        <div class="card card-gold-border" style="display:flex; flex-direction:column; gap:10px;">
            <label style="font-size:11px; color:var(--text-secondary);">NOVO CLIENTE</label>
            <input @bind="novoNome" placeholder="Nome completo" style="padding:10px; border-radius:8px; background:var(--input); color:var(--text-primary); border:1px solid var(--border-soft);" />
            <input @bind="novoTelefone" placeholder="Telefone / WhatsApp" style="padding:10px; border-radius:8px; background:var(--input); color:var(--text-primary); border:1px solid var(--border-soft);" />
            <input @bind="novoEmail" placeholder="E-mail (opcional)" style="padding:10px; border-radius:8px; background:var(--input); color:var(--text-primary); border:1px solid var(--border-soft);" />
            <button class="btn-gold" @onclick="SalvarNovoAsync">SALVAR E INICIAR SIMULAÇÃO</button>
        </div>
    }

    @if (carregando)
    {
        <p style="text-align:center; color:var(--text-muted);">Carregando...</p>
    }
    else if (clientes.Count == 0)
    {
        <p style="text-align:center; color:var(--text-muted); margin-top:20px;">
            Nenhum cliente encontrado.
        </p>
    }
    else
    {
        <div style="display:flex; flex-direction:column; gap:10px;">
            @foreach (var c in clientes)
            {
                <div class="card" style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
                    <div>
                        <div style="font-weight:700;">@c.Nome</div>
                        <div style="font-size:11px; color:var(--text-muted);">
                            @c.TotalSimulacoes simulação(ões) @(string.IsNullOrEmpty(c.Telefone) ? "" : $"• {c.Telefone}")
                        </div>
                    </div>
                    <div style="display:flex; gap:8px;">
                        <button class="btn-outline" style="padding:8px 12px; font-size:10px;" @onclick="() => Nav.NavigateTo($"/clientes/{c.Id}")">
                            HISTÓRICO
                        </button>
                        <button class="btn-gold" style="padding:8px 12px; font-size:10px;" @onclick="() => NovaSimulacaoParaCliente(c)">
                            + SIMULAÇÃO
                        </button>
                    </div>
                </div>
            }
        </div>
    }

</div>

@code {
    private string termoBusca = string.Empty;
    private bool carregando;
    private bool mostrandoNovo;
    private string novoNome = string.Empty;
    private string novoTelefone = string.Empty;
    private string novoEmail = string.Empty;
    private List<ClienteResponse> clientes = new();
    private System.Timers.Timer? debounce;

    protected override async Task OnInitializedAsync()
    {
        await BuscarAsync();
    }

    private void OnKeyUp(KeyboardEventArgs e)
    {
        debounce?.Stop();
        debounce = new System.Timers.Timer(350) { AutoReset = false };
        debounce.Elapsed += async (_, __) => await InvokeAsync(async () =>
        {
            await BuscarAsync();
            StateHasChanged();
        });
        debounce.Start();
    }

    private async Task BuscarAsync()
    {
        carregando = true;
        try
        {
            clientes = await Api.BuscarClientesAsync(termoBusca);
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task SalvarNovoAsync()
    {
        if (string.IsNullOrWhiteSpace(novoNome)) return;

        var criado = await Api.CriarClienteAsync(new CriarClienteRequest
        {
            Nome = novoNome,
            Telefone = novoTelefone,
            Email = novoEmail
        });

        mostrandoNovo = false;

        if (criado is not null)
            NovaSimulacaoParaCliente(criado);
    }

    private void NovaSimulacaoParaCliente(ClienteResponse cliente)
    {
        Nav.NavigateTo($"/captura?clienteId={cliente.Id}&clienteNome={Uri.EscapeDataString(cliente.Nome)}");
    }
}
