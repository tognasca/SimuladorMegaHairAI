@page "/captura"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ApiClient Api

<PageTitle>Nova Simulação</PageTitle>

<div class="sim-page">

    <header class="sim-header">
        <p class="eyebrow">Simulador de Mega Hair</p>
        <h1 class="sim-title">Sua transformação</h1>
        @if (!string.IsNullOrWhiteSpace(ClienteNome))
        {
            <p class="sim-client">Simulação para <strong>@ClienteNome</strong></p>
        }
    </header>

    <ol class="sim-steps" aria-label="Etapas">
        <li class="@(fotoCapturada ? "done" : "current")">1. Foto</li>
        <li class="@(fotoCapturada && resultado is null && !gerando ? "current" : fotoCapturada ? "done" : "")">2. Estilo</li>
        <li class="@(gerando ? "current" : resultado is not null ? "done" : "")">3. Simulação</li>
        <li class="@(resultado is not null ? "current" : "")">4. Resultado</li>
    </ol>

    @if (!fotoCapturada)
    {
        <section class="card card-gold-border sim-card">
            <h2 class="section-title">Envie uma foto para começar</h2>
            <p class="section-copy">Use a câmera do aparelho ou escolha uma foto já salva. O rosto da cliente permanece o mesmo — a IA altera o cabelo.</p>

            <div class="mode-toggle">
                <button type="button" class="@(modo == ModoFoto.Camera ? "btn-gold" : "btn-outline")" @onclick="() => modo = ModoFoto.Camera">
                    Câmera
                </button>
                <button type="button" class="@(modo == ModoFoto.Upload ? "btn-gold" : "btn-outline")" @onclick="() => modo = ModoFoto.Upload">
                    Galeria
                </button>
            </div>
        </section>

        @if (modo == ModoFoto.Camera)
        {
            <div class="card photo-frame">
                <video id="videoPreview" class="photo-media" style="display:@(cameraAtiva ? "block" : "none");"></video>
                @if (!cameraAtiva)
                {
                    <div class="photo-placeholder">Câmera desligada</div>
                }
            </div>

            @if (!cameraAtiva)
            {
                <button type="button" class="btn-gold" @onclick="IniciarCameraAsync">Ligar câmera</button>
            }
            else
            {
                <button type="button" class="btn-gold" @onclick="CapturarFotoAsync">Tirar foto</button>
                <button type="button" class="btn-outline" @onclick="AlternarCameraAsync">Trocar câmera</button>
            }
        }
        else
        {
            <div class="card sim-card">
                <p class="section-copy">Toque abaixo para escolher a imagem. JPG, PNG ou WEBP, até 10 MB.</p>
                <label class="file-pick">
                    <span>Escolher foto</span>
                    <InputFile OnChange="CarregarArquivoAsync" accept="image/png,image/jpeg,image/webp" capture="environment" />
                </label>
                @if (carregandoArquivo)
                {
                    <p class="hint-gold">Carregando foto...</p>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(erro))
        {
            <div class="card error-card">
                <p>@erro</p>
                <button type="button" class="btn-outline" @onclick="TentarNovamenteAsync">Tentar novamente</button>
            </div>
        }
    }
    else
    {
        <div class="card photo-frame">
            <img src="data:@fotoMimeType;base64,@fotoBase64" class="photo-media" alt="Foto da cliente" />
        </div>

        @if (!gerando)
        {
            <button type="button" class="btn-outline" @onclick="RefazerFoto">Tirar outra foto</button>
        }

        @if (resultado is null)
        {
            <div class="card sim-card">
                <h2 class="section-title">Escolha o Mega Hair</h2>

                <label class="field-label">Comprimento</label>
                <select class="field-select" @bind="comprimento" disabled="@gerando">
                    @foreach (var c in comprimentos)
                    {
                        <option value="@c">@c</option>
                    }
                </select>

                <label class="field-label">Cor</label>
                <select class="field-select" @bind="cor" disabled="@gerando">
                    @foreach (var c in cores)
                    {
                        <option value="@c">@c</option>
                    }
                </select>

                <label class="field-label">Tipo de cabelo</label>
                <select class="field-select" @bind="tipoCabelo" disabled="@gerando">
                    @foreach (var t in tipos)
                    {
                        <option value="@t">@t</option>
                    }
                </select>

                <label class="field-label">Método</label>
                <select class="field-select" @bind="metodo" disabled="@gerando">
                    @foreach (var m in metodos)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </div>
        }

        @if (gerando)
        {
            <div class="card loading-ia" aria-live="polite">
                <div class="loading-ring"></div>
                <p class="loading-title">@mensagemLoading</p>
                <p class="section-copy">Isso pode levar cerca de um minuto. Não feche a tela.</p>
            </div>
        }
        else if (resultado is null)
        {
            <button type="button" class="btn-gold" disabled="@gerando" @onclick="() => GerarSimulacaoAsync(forcarNova: false)">
                Gerar simulação
            </button>
        }

        @if (!string.IsNullOrEmpty(erro) && !gerando)
        {
            <div class="card error-card">
                <p>@erro</p>
                <button type="button" class="btn-gold" @onclick="() => GerarSimulacaoAsync(forcarNova: true)">Tentar novamente</button>
            </div>
        }
    }

    @if (resultado is not null && !gerando)
    {
        <section class="card card-gold-border sim-card result-card">
            <h2 class="section-title gold">Resultado</h2>

            <div class="compare-toolbar">
                <button type="button" class="@(mostrarAntes ? "btn-gold" : "btn-outline") btn-compact" @onclick="() => mostrarAntes = true">Antes</button>
                <button type="button" class="@(!mostrarAntes ? "btn-gold" : "btn-outline") btn-compact" @onclick="() => mostrarAntes = false">Depois</button>
            </div>

            <div class="result-hero">
                @if (mostrarAntes)
                {
                    <img src="@resultado.FotoOriginalUrl" alt="Antes" />
                }
                else
                {
                    <img src="@resultado.FotoResultadoUrl" alt="Depois" />
                }
            </div>

            <div class="compare-pair">
                <figure>
                    <figcaption>Antes</figcaption>
                    <img src="@resultado.FotoOriginalUrl" alt="Foto original" />
                </figure>
                <figure>
                    <figcaption class="gold">Depois</figcaption>
                    <img src="@resultado.FotoResultadoUrl" alt="Simulação" />
                </figure>
            </div>

            <p class="price">Estimativa R$ @resultado.ValorEstimado.ToString("N2")</p>

            <div class="result-actions">
                <button type="button" class="btn-gold" @onclick="() => GerarSimulacaoAsync(forcarNova: true)">Gerar novamente</button>
                <button type="button" class="btn-outline" @onclick="EscolherOutroEstilo">Escolher outro estilo</button>
                <a class="btn-outline" href="@resultado.FotoResultadoUrl" target="_blank" rel="noopener" download>Baixar</a>
                <button type="button" class="btn-outline" @onclick="CompartilharAsync">Compartilhar</button>
            </div>
        </section>
    }

</div>

@code {
    [SupplyParameterFromQuery, Parameter] public string? ClienteId { get; set; }
    [SupplyParameterFromQuery, Parameter] public string? ClienteNome { get; set; }
    [SupplyParameterFromQuery(Name = "comprimento"), Parameter] public string? ComprimentoSugerido { get; set; }
    [SupplyParameterFromQuery(Name = "cor"), Parameter] public string? CorSugerida { get; set; }
    [SupplyParameterFromQuery(Name = "tipo"), Parameter] public string? TipoSugerido { get; set; }
    [SupplyParameterFromQuery(Name = "metodo"), Parameter] public string? MetodoSugerido { get; set; }

    private enum ModoFoto { Camera, Upload }
    private ModoFoto modo = ModoFoto.Camera;
    private bool carregandoArquivo;

    private bool cameraAtiva;
    private bool usarCameraFrontal = true;
    private bool fotoCapturada;
    private bool gerando;
    private bool mostrarAntes;
    private string? fotoBase64;
    private string fotoMimeType = "image/png";
    private string? fotoServidorPath;
    private string? erro;
    private string mensagemLoading = "Preparando sua transformação...";
    private SimulacaoResponse? resultado;
    private CancellationTokenSource? loadCts;

    private readonly List<string> comprimentos = new()
    {
        "30 cm", "40 cm", "45 cm", "55 cm", "65 cm", "75 cm", "85 cm"
    };

    private readonly List<string> cores = new()
    {
        "Preto", "Castanho Escuro", "Castanho Claro", "Loiro Escuro",
        "Loiro Médio", "Loiro Claro", "Loiro Platinado", "Ruivo", "Grisalho"
    };

    private readonly List<string> tipos = new() { "Liso", "Ondulado", "Cacheado", "Crespo" };

    private readonly List<string> metodos = new()
    {
        "Fita Adesiva", "Queratina", "Micro Link", "Costurado"
    };

    private string comprimento = "55 cm";
    private string cor = "Castanho Escuro";
    private string tipoCabelo = "Liso";
    private string metodo = "Fita Adesiva";

    private static readonly string[] MensagensProcessamento =
    {
        "Preparando sua transformação...",
        "Analisando o cabelo...",
        "Aplicando o novo visual...",
        "Preservando o rosto e o fundo...",
        "Finalizando os detalhes..."
    };

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(ComprimentoSugerido) && comprimentos.Contains(ComprimentoSugerido))
            comprimento = ComprimentoSugerido;

        if (!string.IsNullOrWhiteSpace(CorSugerida) && cores.Contains(CorSugerida))
            cor = CorSugerida;

        if (!string.IsNullOrWhiteSpace(TipoSugerido) && tipos.Contains(TipoSugerido))
            tipoCabelo = TipoSugerido;

        if (!string.IsNullOrWhiteSpace(MetodoSugerido) && metodos.Contains(MetodoSugerido))
            metodo = MetodoSugerido;
    }

    private async Task IniciarCameraAsync()
    {
        erro = null;
        var ok = await JS.InvokeAsync<bool>("megaHairCamera.iniciar", "videoPreview", usarCameraFrontal);
        if (!ok)
        {
            erro = "Não foi possível acessar a câmera. Verifique a permissão e se o site está em HTTPS.";
            return;
        }
        cameraAtiva = true;
    }

    private async Task AlternarCameraAsync()
    {
        usarCameraFrontal = !usarCameraFrontal;
        await JS.InvokeVoidAsync("megaHairCamera.parar");
        await IniciarCameraAsync();
    }

    private async Task CapturarFotoAsync()
    {
        var base64 = await JS.InvokeAsync<string?>("megaHairCamera.capturar", "videoPreview");
        if (base64 is null)
        {
            erro = "Não foi possível capturar a foto. Tente novamente.";
            return;
        }

        fotoBase64 = base64;
        fotoMimeType = "image/png";
        fotoCapturada = true;
        fotoServidorPath = null;
        await JS.InvokeVoidAsync("megaHairCamera.parar");
        cameraAtiva = false;
    }

    private async Task RefazerFoto()
    {
        fotoCapturada = false;
        fotoBase64 = null;
        fotoMimeType = "image/png";
        fotoServidorPath = null;
        resultado = null;
        erro = null;
        if (modo == ModoFoto.Camera)
            await IniciarCameraAsync();
    }

    private void TentarNovamenteAsync()
    {
        erro = null;
    }

    private void EscolherOutroEstilo()
    {
        resultado = null;
        erro = null;
        mostrarAntes = false;
    }

    private async Task CarregarArquivoAsync(InputFileChangeEventArgs e)
    {
        erro = null;
        carregandoArquivo = true;
        try
        {
            const long tamanhoMaximo = 10 * 1024 * 1024;
            var arquivo = e.File;

            if (arquivo.Size > tamanhoMaximo)
            {
                erro = "Arquivo excede 10 MB. Escolha uma foto menor.";
                return;
            }

            using var stream = arquivo.OpenReadStream(tamanhoMaximo);
            using var memoria = new MemoryStream();
            await stream.CopyToAsync(memoria);

            fotoBase64 = Convert.ToBase64String(memoria.ToArray());
            fotoMimeType = string.IsNullOrWhiteSpace(arquivo.ContentType)
                ? "image/jpeg"
                : arquivo.ContentType;
            fotoCapturada = true;
            fotoServidorPath = null;
            resultado = null;
        }
        catch (Exception)
        {
            erro = "Não foi possível carregar esse arquivo. Verifique se é uma imagem (JPG, PNG ou WEBP).";
        }
        finally
        {
            carregandoArquivo = false;
        }
    }

    private async Task GerarSimulacaoAsync(bool forcarNova)
    {
        if (fotoBase64 is null || gerando) return;

        loadCts?.Cancel();
        loadCts = new CancellationTokenSource();
        var ctLoad = loadCts.Token;
        _ = CiclarMensagensAsync(ctLoad);

        try
        {
            gerando = true;
            erro = null;
            resultado = null;
            mostrarAntes = false;
            StateHasChanged();

            if (string.IsNullOrWhiteSpace(fotoServidorPath))
            {
                var bytes = Convert.FromBase64String(fotoBase64);
                fotoServidorPath = await Api.UploadFotoAsync(bytes, $"captura_{Guid.NewGuid():N}.png");
            }

            var request = new CriarSimulacaoRequest
            {
                FotoOriginalPath = fotoServidorPath,
                Comprimento = comprimento,
                Cor = cor,
                TipoCabelo = tipoCabelo,
                MetodoMegaHair = metodo,
                Provider = SimuladorMegaHair.Domain.Enums.ImageProvider.Replicate,
                ClienteId = Guid.TryParse(ClienteId, out var cid) ? cid : null,
                ForcarNovaGeracao = forcarNova
            };

            resultado = await Api.CriarSimulacaoAsync(request);
        }
        catch (Exception ex)
        {
            erro = ApiClient.MensagemAmigavel(
                ex,
                "Não conseguimos gerar a simulação desta vez. Vamos tentar novamente?");
        }
        finally
        {
            loadCts.Cancel();
            gerando = false;
        }
    }

    private async Task CiclarMensagensAsync(CancellationToken ct)
    {
        var i = 0;
        try
        {
            while (!ct.IsCancellationRequested)
            {
                mensagemLoading = MensagensProcessamento[i % MensagensProcessamento.Length];
                await InvokeAsync(StateHasChanged);
                await Task.Delay(3200, ct);
                i++;
            }
        }
        catch (TaskCanceledException)
        {
            // esperado ao terminar
        }
    }

    private async Task CompartilharAsync()
    {
        if (resultado is null) return;
        try
        {
            await JS.InvokeVoidAsync("megaHairShare.compartilhar", resultado.FotoResultadoUrl);
        }
        catch
        {
            erro = "Não foi possível compartilhar agora. Use Baixar e envie pelo WhatsApp.";
        }
    }

    public async ValueTask DisposeAsync()
    {
        loadCts?.Cancel();
        loadCts?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("megaHairCamera.parar");
        }
        catch
        {
            // circuito já encerrado
        }
    }
}
