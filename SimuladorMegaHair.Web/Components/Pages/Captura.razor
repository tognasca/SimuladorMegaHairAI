    private string NomeOrigem(string origem) =>
        origensDisponiveis.FirstOrDefault(item => item.Id == origem)?.Nome ?? "Não informada";

    private static string PrecoOpcional(ApiClient.OpcaoOrcamento item)
    {
        var unidade = item.Calculo switch { "grama" => "/g", "unidade" => "/un.", _ => "" };
        return $"R$ {item.Valor.GetValueOrDefault().ToString("0.00##", PtBr)}{unidade}";
    }

    private string NotaSobConsulta() =>
        opcoesOrcamento?.SobConsulta is { Length: > 0 } itens
            ? $"Sob consulta com o salão: {string.Join(", ", itens)}."
            : "Coloração, se necessária, é orçada à parte após avaliação.";

    private string ResumoExtras() => string.Join(", ",
        (opcoesOrcamento?.Extras ?? []).Where(item => extrasSelecionados[item.Id] > 0)
            .Select(item => item.Calculo == "unidade" ? $"{item.Nome} ({extrasSelecionados[item.Id]})" : item.Nome));

    private string NomeContatoSalao => Config["Salao:Nome"] ?? "a Tati";

    private string MensagemParaTati()
    {
        var origem = NomeOrigem(origemCabelo);
        var gramagem = quantidadeGramas is > 0 ? $"{quantidadeGramas} g" : "Não informada";
        var preco = resultado?.PrecoMegaHairProIndisponivel == false && quantidadeGramas is > 0
            ? $"R$ {resultado.ValorEstimado.ToString("N2", PtBr)}"
            : "A confirmar com o salão";
        return string.Join("\n",
            "Olá! Quero conversar sobre o resultado da minha simulação de mega hair.",
            $"Origem: {origem}",
            $"Comprimento: {comprimento} | Textura: {tipoCabelo}",
            $"Método: {metodo} | Quantidade: {gramagem}",
            $"Estimativa do mega hair: {preco}",
            $"Itens opcionais: {(ResumoExtras() is { Length: > 0 } itens ? itens : "Nenhum")}",
            $"Cor simulada: {cor}. {NotaSobConsulta()}");
    }

    private Task RegistrarCliqueWhatsAppAsync() => resultado is { } simulacao
        ? Api.RegistrarCliqueWhatsAppAsync(simulacao.Id)
        : Task.CompletedTask;

    private string LinkWhatsAppTati()
    {
        var numero = new string((Config["Salao:WhatsApp"] ?? Config["Tati:WhatsApp"] ?? "").Where(char.IsAsciiDigit).ToArray());
        return $"https://wa.me/{numero}?text={Uri.EscapeDataString(MensagemParaTati())}";
    }

    private async Task CompartilharComTatiAsync()
    {
        if (resultado is null) return;
        avisoCompartilhar = null;
        try
        {
            var status = await JS.InvokeAsync<string>(
                "megaHairResultado.compartilharOrcamento", resultado.FotoResultadoUrl, MensagemParaTati());
            if (status == "ok" || status == "cancelado") return;
        }
        catch (JSException) { }
        avisoCompartilhar = "Salve a foto e use Abrir orçamento no WhatsApp para anexá-la na conversa com o salão.";
    }

    private async Task SalvarAsync()
    {
        if (resultado is null || salvando) return;
        salvando = true; salvo = false; avisoSalvar = null;
        StateHasChanged();
        try
        {
            var r = await JS.InvokeAsync<ResultadoSalvar>("megaHairResultado.salvar", UrlParaSalvar(), "minha-transformacao-tati-megahair.png");
            if (r.Ok) { salvo = true; }
            else if (r.Motivo == "cancelado") { /* a cliente fechou a folha de compartilhar */ }
            else avisoSalvar = "Não consegui salvar direto. Abra a imagem e segure o dedo sobre ela (ou clique com o botão direito) para salvar.";
        }
        catch { avisoSalvar = "Não consegui salvar agora. Abra a imagem e segure o dedo sobre ela para salvar."; }
        finally { salvando = false; }
    }

    // Baixa pela própria origem do site (/baixar/resultado/...), sem depender de CORS na API pública.
    private string UrlParaSalvar()
    {
        var url = resultado?.FotoResultadoUrl;
        if (string.IsNullOrWhiteSpace(url)) return string.Empty;
        try
        {
            var caminho = Uri.TryCreate(url, UriKind.Absolute, out var abs) ? abs.AbsolutePath : url;
            var nome = System.IO.Path.GetFileName(caminho);
            if (!string.IsNullOrWhiteSpace(nome)) return "/baixar/resultado/" + Uri.EscapeDataString(nome);
        }
        catch { /* usa a URL original */ }
        return url;
    }

    private async Task RecarregarComparador()
    {
        if (resultado is not null)
        {
            try
            {
                var atualizado = await Api.RenovarLinksSimulacaoAsync(resultado.Id);
                if (atualizado is not null && !string.IsNullOrWhiteSpace(atualizado.FotoResultadoUrl))
                    resultado = atualizado;
            }
            catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or System.Text.Json.JsonException)
            {
                erro = "Não foi possível atualizar a foto. Verifique a conexão e tente novamente.";
            }
        }
        tentativaComparador++;
        comparadorPronto = false;
        comparadorFalhou = false;
        iniciarComparadorPendente = true;
    }

