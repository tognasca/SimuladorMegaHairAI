    {
        await JS.InvokeVoidAsync("megaHairResultado.destruirComparador");
        resultado = null; erro = null; salvo = false; avisoSalvar = null; comparadorFalhou = false;
        passoEstilo = 0; etapa = Etapa.Estilo;
    }

    private async Task NovaSimulacaoAsync()
    {
        await JS.InvokeVoidAsync("megaHairResultado.destruirComparador");
        await JS.InvokeVoidAsync("megaHairEspelho.liberar");
        foto = null; fotoServidorPath = null; resultado = null; erro = null; salvo = false; avisoSalvar = null; comparadorFalhou = false;
        passoEstilo = 0; etapa = Etapa.Foto;
    }

    public async ValueTask DisposeAsync()
    {
        DesconectarTv();
        geracaoCts?.Cancel();
        geracaoCts?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("megaHairResultado.destruirComparador");
            await JS.InvokeVoidAsync("megaHairEspelho.liberar");
        }
        catch { /* circuito já encerrado */ }
        selfRef?.Dispose();
    }
