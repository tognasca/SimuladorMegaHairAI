    private void Avancar() { if (passoEstilo < 2) passoEstilo++; }
    private void Voltar() { if (passoEstilo > 0) passoEstilo--; }

    private string ClassePasso(int i) => i < passoEstilo ? "mh-feito" : i == passoEstilo ? "mh-atual" : "";

    // Posição (em unidades do SVG) da linha que marca o comprimento na silhueta.
    private double OffsetComprimento()
    {
        var cm = int.TryParse(new string(comprimento.Where(char.IsDigit).ToArray()), out var v) ? v : 55;
        var t = Math.Clamp((cm - 30) / 55.0, 0, 1);
        return 78 + t * 78; // ombros → cintura
    }

    // Mesmas faixas que o backend usa para descrever o comprimento à IA.
    private static string AlturaDescricao(string c)
    {
        var cm = int.TryParse(new string(c.Where(char.IsDigit).ToArray()), out var v) ? v : 55;
        return cm switch
        {
            <= 30 => "Na altura dos ombros",
            <= 42 => "Logo acima do peito",
            <= 50 => "Na altura do peito",
            <= 60 => "Logo abaixo do peito",
            <= 75 => "Perto do umbigo",
            _ => "Na altura da cintura"
        };
    }

