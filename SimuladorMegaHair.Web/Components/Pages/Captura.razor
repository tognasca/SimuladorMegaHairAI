@page "/captura"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ApiClient Api
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider Auth
@inject SimuladorMegaHair.Web.Services.SalaoTv Salao
@inject Microsoft.Extensions.Configuration.IConfiguration Config
<PageTitle>Sua transformação — Tati Mega Hair</PageTitle>

<div class="mh-app">
    <section class="tat-capture-intro">
        <span class="tat-page-eyebrow">TATI MEGA HAIR · EXPERIÊNCIA PERSONALIZADA</span>
        <h1>Seu próximo visual começa <em>aqui</em></h1>
        <p>Escolha sua foto, personalize o cabelo e visualize novas possibilidades com a sua própria imagem.</p>
    </section>

    <AuthorizeView>
        <Authorized>
            <section class="mh-tela" aria-label="Modo Salão">
                <details open="@(controleTv is not null)">
                    <summary>Modo Salão · TV</summary>
                    @if (controleTv is null)
                    {
                        <p>Abra <a href="/tv" target="_blank" rel="noopener">/tv</a> no navegador da Smart TV e digite o código abaixo.</p>
                        <label for="salao-codigo">Código da TV</label>
                        <input id="salao-codigo" class="form-control" inputmode="numeric" maxlength="6" @bind="codigoTv" />
                        <button type="button" class="mh-btn mh-btn-secundario" @onclick="ParearTvAsync">Parear TV</button>
                    }
                    else
                    {
                        <p>TV conectada</p>
                        @if (etapa == Etapa.Resultado && resultado is not null && !resultado.PrecoMegaHairProIndisponivel && quantidadeGramas is > 0)
                        {
                            <button type="button" class="mh-btn mh-btn-secundario" @onclick="() => exibirOrcamentoTv = !exibirOrcamentoTv">
                                @(exibirOrcamentoTv ? "Ocultar orçamento na TV" : "Mostrar orçamento na TV")
                            </button>
                        }
                        <button type="button" class="mh-btn mh-btn-secundario" @onclick="EncerrarTvAsync">Encerrar atendimento na TV</button>
                    }
                    @if (mensagemTv is not null)
                    {
                        <p role="status">@mensagemTv</p>
                    }
                </details>
            </section>
        </Authorized>
    </AuthorizeView>

    @* O seletor de arquivo fica SEMPRE no DOM: o <label for> abre a galeria direto
       (gesto nativo do toque), e o JS processa a foto assim que ela é escolhida. *@
    <input id="mh-arquivo" class="mh-oculto-visual" type="file" accept="image/*" tabindex="-1" aria-hidden="true" />

    @* ─────────────────────────────  1. SUA FOTO  ───────────────────────────── *@
    @if (etapa == Etapa.Foto)
    {
        <section class="mh-tela mh-tela-foto">
            <ol class="mh-passos" aria-label="Etapas">
                <li class="mh-atual">Sua foto</li><li>Comprimento</li><li>Cor</li><li>Textura</li><li>Transformação</li>
            </ol>

            <h1 class="mh-titulo">✨ Sua transformação começa aqui</h1>
            <p class="mh-subtitulo">Descubra como você ficaria com o mega hair dos seus sonhos.</p>
            @if (!string.IsNullOrWhiteSpace(ClienteNome))
            {
                <p class="mh-cliente">Simulação para <strong>@ClienteNome</strong></p>
            }

            <div class="mh-moldura mh-moldura-camera" aria-hidden="true">
                <div class="mh-camera-ornamento">
                    <svg viewBox="0 0 160 160" focusable="false">
                        <rect x="31" y="43" width="98" height="73" rx="16" class="mh-camera-corpo" />
                        <path d="M48 43 L58 29 H83 L94 43" class="mh-camera-detalhe" />
                        <circle cx="80" cy="79" r="22" class="mh-camera-lente-aro" />
                        <circle cx="80" cy="79" r="14" class="mh-camera-lente" />
                        <path d="M21 22 Q8 80 22 138 M139 22 Q152 80 138 138" class="mh-camera-fio" />
                        <path d="M39 128 Q80 144 121 128" class="mh-camera-fio" />
                        <path d="M123 23 l4 9 l9 4 l-9 4 l-4 9 l-4 -9 l-9 -4 l9 -4z" class="mh-camera-estrela" />
                    </svg>
                </div>
                <span class="mh-moldura-legenda">ENQUADRE SUA BELEZA</span>
            </div>

            @if (!string.IsNullOrEmpty(erro))
            {
                <div class="mh-alerta" role="alert">@erro</div>
            }

            <div class="mh-acoes-principais">
                <button type="button" class="mh-btn mh-btn-primario" @onclick="AbrirEspelhoAsync">📸 TIRAR FOTO</button>
                <label for="mh-arquivo" class="mh-btn mh-btn-secundario" role="button" tabindex="0">🖼️ ESCOLHER DA GALERIA</label>
            </div>
            <p class="mh-nota">Use uma foto de frente, com boa iluminação, enquadrando do topo da cabeça até a cintura.</p>
        </section>
    }

    @* ─────────────────────────────  REVISÃO DA FOTO  ───────────────────────────── *@
    @if (etapa == Etapa.Revisao && foto is not null)
    {
        <section class="mh-tela mh-tela-revisao">
            <h2 class="mh-titulo mh-titulo-menor">Ficou do jeito que você quer?</h2>
            <div class="mh-revisao-foto" style="--ar:@foto.Largura / @foto.Altura">
                <img src="@(foto.UrlFiltrada ?? foto.UrlNatural)" alt="Sua foto" />
                @if (foto.UrlFiltrada is not null)
                {
                    <span class="mh-selo">Efeito: @foto.FiltroNome</span>
                }
            </div>
            @if (foto.UrlFiltrada is not null)
            {
                <p class="mh-nota">Para um resultado fiel, a simulação usa a sua foto <strong>natural</strong>, sem efeitos. Assim a cor real do seu cabelo é preservada.</p>
            }
            @if (foto.Ajustada)
            {
                <p class="mh-nota">Ajustamos o enquadramento da foto para o formato retrato.</p>
            }
            <div class="mh-acoes-principais">
                <button type="button" class="mh-btn mh-btn-primario" @onclick="UsarFoto">Usar esta foto</button>
                <button type="button" class="mh-btn mh-btn-secundario" @onclick="RefazerFotoAsync">↺ Refazer a foto</button>
            </div>
        </section>
    }

    @* ─────────────────────────────  2–4. ESCOLHAS  ───────────────────────────── *@
    @if (etapa == Etapa.Estilo && foto is not null)
    {
        <section class="mh-tela mh-tela-estilo">
            <ol class="mh-passos" aria-label="Etapas">
                <li class="mh-feito">Sua foto</li>
                <li class="@ClassePasso(0)">Comprimento</li>
                <li class="@ClassePasso(1)">Cor</li>
                <li class="@ClassePasso(2)">Textura</li>
                <li>Transformação</li>
            </ol>

            <div class="mh-resumo">
                <img src="@foto.UrlNatural" alt="Sua foto" class="mh-resumo-foto" />
                <div class="mh-resumo-texto">
                    <span>@comprimento · @cor · @tipoCabelo</span>
                    <button type="button" class="mh-link" @onclick="TrocarFotoAsync">Trocar foto</button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(erro))
            {
                <div class="mh-alerta" role="alert">
                    @erro
                    <button type="button" class="mh-link" @onclick="() => erro = null">Fechar</button>
                </div>
            }

            @if (passoEstilo == 0)
            {
                <div class="mh-guia-comprimento">
                    <h2 class="mh-titulo mh-titulo-menor">Escolha o comprimento</h2>
                    <div class="mh-guia-tamanhos" role="group" aria-label="Comprimento">
                        @foreach (var c in comprimentos)
                        {
                            <button type="button" class="mh-guia-tamanho"
                                    aria-pressed="@(comprimento == c ? "true" : "false")"
                                    @onclick="() => comprimento = c">@c</button>
                        }
                    </div>
                    <figure class="mh-guia-foto">
                        <img src="images/comprimentos/@(comprimento.Replace(" cm", "")).webp"
                             alt="Referência de cabelo ondulado visto de costas com @comprimento"
                             width="420" height="420" />
                        <figcaption aria-live="polite">
                            <strong>Referência visual · @comprimento</strong>
                            <span>A altura varia de pessoa para pessoa.</span>
                        </figcaption>
                    </figure>
                </div>
            }
            else if (passoEstilo == 1)
            {
                <h2 class="mh-titulo mh-titulo-menor">Escolha a cor</h2>
                <div class="mh-cores" role="radiogroup" aria-label="Cor">
                    @foreach (var c in cores)
                    {
                        var t = Fios[c];
                        <button type="button" role="radio" aria-checked="@(cor == c ? "true" : "false")"
                                class="mh-cor @(cor == c ? "mh-sel" : "")" @onclick="() => cor = c"
                                style="--fio-escuro:@t.Escuro; --fio-base:@t.Base; --fio-claro:@t.Claro">
                            <span class="mh-cor-fios"></span>
                            <span class="mh-cor-nome">@c</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <h2 class="mh-titulo mh-titulo-menor">Escolha a textura</h2>
                <div class="mh-texturas" role="radiogroup" aria-label="Textura">
                    @foreach (var t in tipos)
                    {
                        <button type="button" role="radio" aria-checked="@(tipoCabelo == t ? "true" : "false")"
                                class="mh-textura @(tipoCabelo == t ? "mh-sel" : "")" @onclick="() => tipoCabelo = t">
                            @((MarkupString)SvgTextura(t))
                            <span>@t</span>
                        </button>
                    }
                </div>

                <div class="mh-metodo">
                    <span class="mh-metodo-titulo">Método de aplicação</span>
                    <div class="mh-chips" role="radiogroup" aria-label="Método de aplicação">
                        @foreach (var m in metodos)
                        {
                            <button type="button" role="radio" aria-checked="@(metodo == m ? "true" : "false")"
                                    class="mh-chip mh-chip-pequeno @(metodo == m ? "mh-sel" : "")" @onclick="() => metodo = m">@m</button>
                        }
                    </div>
                </div>
                <div class="mh-metodo">
                    <label class="mh-metodo-titulo" for="mh-origem">Origem do cabelo</label>
                    <select id="mh-origem" class="form-select" @bind="origemCabelo">
                        <option value="">Selecione</option>
                        @foreach (var origem in origensDisponiveis)
                        {
                            <option value="@origem.Id">@origem.Nome</option>
                        }
                    </select>
                </div>
                <div class="mh-metodo">
                    <label class="mh-metodo-titulo" for="mh-quantidade">Quantidade de cabelo (g)</label>
                    <input id="mh-quantidade" class="form-control" type="number" min="1" step="1"
                           inputmode="numeric" @bind="quantidadeGramas" />
                </div>
                <button type="button" class="mh-link" @onclick="AbrirRecuperacaoPix">
                    Já comprei créditos
                </button>
                @if (opcoesOrcamento?.Extras is { Length: > 0 } extras)
                {
                    <div class="mh-metodo">
                        <h3 class="mh-metodo-titulo">Itens opcionais</h3>
                        @foreach (var item in extras)
                        {
                            <div @key="item.Id" class="mb-2">
                                <label for="@($"extra-{item.Id}")">@item.Nome · @PrecoOpcional(item)</label>
                                @if (item.Calculo == "unidade")
                                {
                                    <input id="@($"extra-{item.Id}")" class="form-control" type="number" min="0" max="100"
                                           aria-label="@($"Quantidade de {item.Nome}")" @bind="extrasSelecionados[item.Id]" />
                                }
                                else
                                {
                                    <input id="@($"extra-{item.Id}")" type="checkbox"
                                           checked="@(extrasSelecionados[item.Id] > 0)"
                                           @onchange="e => extrasSelecionados[item.Id] = e.Value is true ? 1 : 0" />
                                }
                            </div>
                        }
                    </div>
                }
            }

            <div class="mh-rodape-fixo">
                @if (passoEstilo > 0)
                {
                    <button type="button" class="mh-btn mh-btn-secundario mh-btn-voltar" @onclick="Voltar" aria-label="Voltar">←</button>
                }
                @if (passoEstilo < 2)
                {
                    <button type="button" class="mh-btn mh-btn-primario" @onclick="Avancar">Continuar</button>
                }
                else
                {
                    <button type="button" class="mh-btn mh-btn-primario" disabled="@consultandoPrevia" @onclick="ConfirmarEscolhasAsync">
                        @(consultandoPrevia ? "Consultando orçamento…" : "✨ Transformar meu visual")
                    </button>
                }
            </div>
        </section>
    }

    @if (etapa == Etapa.RecuperarPix)
    {
        <section class="mh-tela" aria-labelledby="recuperar-pix-titulo">
            <h2 id="recuperar-pix-titulo" class="mh-titulo mh-titulo-menor">Recuperar créditos</h2>
            <label for="recuperar-pix-codigo">Código privado da carteira</label>
            <input id="recuperar-pix-codigo" class="form-control" type="password" autocomplete="off"
                   maxlength="64" @bind="codigoRecuperacaoPix" />
            <button type="button" class="mh-btn mh-btn-primario" disabled="@consultandoPix"
                    @onclick="RecuperarCarteiraAsync">Recuperar carteira</button>
            <button type="button" class="mh-link" disabled="@consultandoPix" @onclick="VoltarDoPix">Voltar às escolhas</button>
            @if (mensagemPix is not null) { <p role="status">@mensagemPix</p> }
        </section>
    }

    @if (ofertaPix is { Ativo: true } oferta && etapa == Etapa.Creditos)
    {
        <section class="mh-tela mh-tela-estilo" aria-labelledby="mh-pix-titulo">
            <h2 id="mh-pix-titulo" class="mh-titulo mh-titulo-menor">Comprar novas simulações</h2>
            <p>@(pix?.Quantidade ?? oferta.Quantidade) gerações por R$ @((pix?.Preco ?? oferta.Preco).ToString("N2", PtBr)), via Pix.</p>
            @if (pix?.Status == "approved")
            {
                <p role="status">Pagamento aprovado. Seus créditos estão disponíveis neste navegador.</p>
                <button type="button" class="mh-btn mh-btn-primario" @onclick="() => GerarSimulacaoAsync(forcarNovaPix)">Gerar meu visual</button>
            }
            else if (pix?.CopiaECola is { Length: > 0 } copia)
            {
                @if (pix.Qr is { Length: > 0 } qr)
                {
                    <img src="@($"data:image/png;base64,{qr}")" alt="QR Code Pix" width="180" height="180" />
                }
                <label for="mh-pix-codigo">Pix copia e cola</label>
                <textarea id="mh-pix-codigo" class="form-control" readonly rows="3">@copia</textarea>
                <button type="button" class="mh-btn mh-btn-primario" disabled="@consultandoPix" @onclick="VerificarPixAsync">Verificar pagamento</button>
            }
            else
            {
                <label for="mh-pix-email">E-mail do pagador</label>
                <input id="mh-pix-email" class="form-control" type="email" maxlength="254" @bind="emailPix" />
                <label for="mh-pix-cpf">CPF do pagador</label>
                <input id="mh-pix-cpf" class="form-control" inputmode="numeric" maxlength="14" @bind="cpfPix" />
                <button type="button" class="mh-btn mh-btn-primario" disabled="@consultandoPix" @onclick="CriarPixAsync">Gerar Pix</button>
                @if (pedidoPix != Guid.Empty)
                {
                    <button type="button" class="mh-btn mh-btn-secundario" disabled="@consultandoPix" @onclick="VerificarPixAsync">Verificar Pix anterior</button>
                }
            }
            <details>
                <summary>Código para recuperar créditos em outro aparelho</summary>
                <p>Guarde este código em um local privado antes de pagar. Quem tiver o código pode usar o saldo.</p>
                <label for="backup-pix">Código da carteira</label>
                <input id="backup-pix" class="form-control" readonly value="@carteiraPix" />
            </details>
            @if (mensagemPix is not null)
            {
                <p role="status">@mensagemPix</p>
            }
            <button type="button" class="mh-link" disabled="@consultandoPix" @onclick="VoltarDoPix">Voltar às escolhas</button>
        </section>
    }

    @if (etapa == Etapa.Orcamento)
    {
        <section class="mh-tela mh-tela-estilo" aria-labelledby="mh-titulo-orcamento">
            <h2 id="mh-titulo-orcamento" class="mh-titulo mh-titulo-menor">Seu orçamento de mega hair</h2>
            <div class="mh-resultado-meta">
                <span>@NomeOrigem(origemCabelo) · @comprimento · @tipoCabelo</span>
                <span>@metodo · @(quantidadeGramas is > 0 ? $"{quantidadeGramas} g" : "Gramagem não informada")</span>
                <strong>@(precoPrevia is > 0 ? $"Estimativa R$ {precoPrevia.Value.ToString("N2", PtBr)}" : "Orçamento indisponível no momento")</strong>
            </div>
            <p class="mh-nota">@NotaSobConsulta()</p>
            @if (ResumoExtras() is { Length: > 0 } resumo)
            {
                <p class="mh-nota">Itens opcionais: @resumo</p>
            }
            <div class="mh-acoes-principais">
                <button type="button" class="mh-btn mh-btn-primario" @onclick="() => GerarSimulacaoAsync(forcarNova: false)">Gerar meu visual</button>
                <button type="button" class="mh-btn mh-btn-secundario" @onclick="() => etapa = Etapa.Estilo">Ajustar escolhas</button>
            </div>
        </section>
    }

    @* ─────────────────────────────  GERANDO  ───────────────────────────── *@
    @if (etapa == Etapa.Gerando)
    {
        <section class="mh-carregando" role="status" aria-live="polite">
            @if (foto is not null)
            {
                <div class="mh-carregando-fundo" style="background-image:url('@foto.UrlNatural')"></div>
            }
            <div class="mh-carregando-miolo">
                <div class="mh-anel" aria-hidden="true"><span>✦</span></div>
                <h2 class="mh-titulo mh-titulo-menor">✨ Estamos preparando seu novo visual</h2>
                <p class="mh-fase">@(faseEnvio ? "Enviando sua foto…" : "Gerando sua simulação…")</p>
                <p class="mh-dica" aria-hidden="true">@MensagensCarregamento[indiceMensagem % MensagensCarregamento.Length]</p>
                <div class="mh-barra-indeterminada" aria-hidden="true"><span></span></div>
                <small>Isso costuma levar cerca de 1 minuto. Não feche esta tela.</small>
                <button type="button" class="mh-link" @onclick="CancelarGeracao">Cancelar</button>
            </div>
        </section>
    }

    @* ─────────────────────────────  RESULTADO  ───────────────────────────── *@
    @if (etapa == Etapa.Resultado && resultado is not null)
    {
        <section class="mh-tela mh-tela-resultado">
            <h2 class="mh-titulo">@(comparadorPronto ? "✨ Seu novo visual está pronto!" : comparadorFalhou ? "Resultado da simulação" : "Carregando seu novo visual…")</h2>

            <div @key="tentativaComparador" class="mh-comp-wrap" id="mh-comp-wrap"
                 aria-hidden="@(!comparadorPronto ? "true" : "false")"
                 hidden="@comparadorFalhou">
                <div class="mh-comp" tabindex="-1">
                    <div class="mh-comp-stage">
                        <img class="mh-comp-img mh-comp-antes" src="@(foto?.UrlNatural ?? resultado.FotoOriginalUrl)" alt="Antes" draggable="false" />
                        <img class="mh-comp-img mh-comp-depois" src="@resultado.FotoResultadoUrl" alt="Depois" draggable="false" />
                    </div>
                    <div class="mh-comp-handle" role="slider" tabindex="0" aria-label="Comparar antes e depois"
                         aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
                        <span class="mh-comp-knob" aria-hidden="true">‹ ›</span>
                    </div>
                    <span class="mh-comp-tag mh-comp-tag-antes">Antes</span>
                    <span class="mh-comp-tag mh-comp-tag-depois">Depois</span>
                    <div class="mh-comp-tools">
                        <button type="button" data-acao="zoom-mais" aria-label="Aproximar">+</button>
                        <button type="button" data-acao="zoom-menos" aria-label="Afastar">−</button>
                        <button type="button" data-acao="restaurar" aria-label="Restaurar enquadramento">⟲</button>
                        <button type="button" data-acao="tela-cheia" aria-label="Tela cheia">⛶</button>
                    </div>
                </div>
                <div class="mh-comp-modos" role="group" aria-label="Visualização das fotos">
                    <button type="button" data-modo="antes" aria-pressed="false">Antes</button>
                    <button type="button" data-modo="comparar" aria-pressed="true">Comparar</button>
                    <button type="button" data-modo="depois" aria-pressed="false">Depois</button>
                </div>
            </div>

            @if (comparadorFalhou)
            {
                <div class="mh-alerta" role="alert">Não consegui abrir a imagem gerada. <button type="button" class="mh-link" @onclick="RecarregarComparador">Recarregar imagem</button></div>
            }

            <div class="mh-resultado-meta">
                <span>@metodo · @comprimento · @cor · @tipoCabelo</span>
                @if (resultado.PrecoMegaHairProIndisponivel || quantidadeGramas is null)
                {
                    <strong>Preço indisponível no momento</strong>
                }
                else
                {
                    <strong>Estimativa R$ @resultado.ValorEstimado.ToString("N2", PtBr)</strong>
                }
            </div>

            <p class="mh-nota">O orçamento considera o mega hair, a aplicação e os itens incluídos ou selecionados. @NotaSobConsulta()</p>
            @if (ResumoExtras() is { Length: > 0 } extrasResultado)
            {
                <p class="mh-nota">Itens opcionais: @extrasResultado</p>
            }

            <div class="mh-acoes-principais">
                <button type="button" class="mh-btn mh-btn-primario" disabled="@(!comparadorPronto)" @onclick="CompartilharComTatiAsync">Enviar foto e orçamento para @NomeContatoSalao</button>
                <a class="mh-link" href="@LinkWhatsAppTati()" @onclick="RegistrarCliqueWhatsAppAsync" target="_blank" rel="noopener">Abrir orçamento no WhatsApp</a>
                @if (!string.IsNullOrEmpty(avisoCompartilhar))
                {
                    <p class="mh-nota" role="status">@avisoCompartilhar</p>
                }
                <button type="button" class="mh-btn mh-btn-secundario @(salvo ? "mh-ok" : "")" disabled="@(salvando || !comparadorPronto)" @onclick="SalvarAsync">
                    @(salvando ? "Salvando…" : salvo ? "✓ Salvo!" : "💾 Salvar minha transformação")
                </button>
                <button type="button" class="mh-btn mh-btn-secundario" @onclick="ExperimentarOutroVisual">✨ Experimentar outro visual</button>
                <button type="button" class="mh-btn mh-btn-secundario" @onclick="NovaSimulacaoAsync">📸 Fazer nova simulação</button>
            </div>

            @if (!string.IsNullOrEmpty(avisoSalvar))
            {
                <p class="mh-nota" role="status">@avisoSalvar <a href="@resultado.FotoResultadoUrl" target="_blank" rel="noopener">Abrir imagem</a></p>
            }
            <button type="button" class="mh-link mh-link-centro" @onclick="() => GerarSimulacaoAsync(forcarNova: true)">↻ Gerar outra versão deste visual</button>
        </section>
    }

    @* ─────────────────────────────  ESPELHO VIRTUAL (câmera em tela cheia)  ───────────────────────────── *@
    @if (espelhoAberto)
    {
        <div class="mh-espelho" role="dialog" aria-modal="true" aria-label="Espelho Virtual">
            <video id="mh-video" class="mh-video-oculto" playsinline muted autoplay></video>

            <header class="mh-espelho-topo">
                <button type="button" class="mh-icone mh-voltar-espelho" @onclick="FecharEspelhoAsync" aria-label="Voltar">‹</button>
                <a class="mh-espelho-marca" href="/" aria-label="Tati Mega Hair início">
                    <span>Tati <em>Mega Hair</em></span><small>SIMULADOR</small>
                </a>
                <div class="mh-topo-acoes">
                    <button type="button" class="mh-icone mh-trocar-camera @(cameraMultipla ? "" : "mh-invisivel")" @onclick="AlternarCameraAsync"
                            aria-label="Alternar câmera" disabled="@(!cameraMultipla)">⟳</button>
                    <button type="button" class="mh-salvar-topo" @onclick="CapturarAsync" disabled="@(erroCamera is not null || !cameraPronta)">Salvar</button>
                </div>
            </header>

            <div class="mh-espelho-meio">
                <div class="mh-palco" id="mh-palco">
                    <canvas id="mh-preview" class="mh-preview"></canvas>
                    <svg class="mh-guia" viewBox="0 0 200 300" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                        <ellipse cx="100" cy="59" rx="27" ry="35" />
                        <path d="M72 103 C52 113 43 137 38 165 L24 292 M128 103 C148 113 157 137 162 165 L176 292" />
                        <path d="M39 229 Q100 247 161 229" />
                    </svg>
                    <div class="mh-palco-dicas">
                        <span>Afaste-se um pouco e enquadre do topo da cabeça até a cintura.</span>
                        <small>Deixe os ombros e a cintura visíveis para um resultado mais fiel.</small>
                    </div>

                    @if (erroCamera is not null)
                    {
                        <div class="mh-camera-erro" role="alert">
                            <strong>Não foi possível abrir a câmera</strong>
                            <p>@MensagemErroCamera(erroCamera)</p>
                            <div class="mh-acoes-principais">
                                @if (erroCamera is not "sem-camera" and not "sem-suporte" and not "inseguro")
                                {
                                    <button type="button" class="mh-btn mh-btn-primario" @onclick="TentarCameraNovamenteAsync">Tentar novamente</button>
                                }
                                <label for="mh-arquivo" class="mh-btn mh-btn-secundario" role="button" tabindex="0">🖼️ Escolher da galeria</label>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <footer class="mh-espelho-base" id="mh-controles">
                <div class="mh-filtros" role="group" aria-label="Efeitos">
                    @foreach (var f in Filtros)
                    {
                        <button type="button" class="mh-filtro" data-filtro="@f.Id" aria-pressed="false">
                            <canvas class="mh-miniatura mh-miniatura-oculta" data-miniatura="@f.Id" width="56" height="84"></canvas>
                            <span class="mh-efeito-icone" aria-hidden="true">@(f.Id switch { "natural" => "◉", "soft" => "☼", "studio" => "✧", "golden" => "♢", "clean" => "◌", "portrait" => "♡", _ => "✧" })</span>
                            <span class="mh-efeito-nome">@f.Nome</span>
                        </button>
                    }
                </div>
                <div class="mh-intensidade mh-sem-efeito">
                    <label for="mh-intensidade-slider">Intensidade</label>
                    <input id="mh-intensidade-slider" type="range" min="0" max="100" step="1" data-intensidade aria-label="Intensidade do efeito" />
                    <button type="button" class="mh-link" data-remover-efeitos>Remover efeitos</button>
                </div>
                <div class="mh-obturador-linha">
                    <button type="button" class="mh-obturador" @onclick="CapturarAsync" disabled="@(erroCamera is not null || !cameraPronta)" aria-label="Tirar foto"><span aria-hidden="true">✦</span><strong>Tirar foto</strong><b aria-hidden="true">→</b></button>
                </div>
            </footer>
        </div>
    }
</div>

@code {
    // ── Parâmetros de URL (preservados do original) ──────────────────────────
    [SupplyParameterFromQuery, Parameter] public string? ClienteId { get; set; }
    [SupplyParameterFromQuery, Parameter] public string? ClienteNome { get; set; }
    [SupplyParameterFromQuery(Name = "comprimento"), Parameter] public string? ComprimentoSugerido { get; set; }
    [SupplyParameterFromQuery(Name = "cor"), Parameter] public string? CorSugerida { get; set; }
    [SupplyParameterFromQuery(Name = "tipo"), Parameter] public string? TipoSugerido { get; set; }
    [SupplyParameterFromQuery(Name = "metodo"), Parameter] public string? MetodoSugerido { get; set; }

    // ── Estado ───────────────────────────────────────────────────────────────
    private enum Etapa { Foto, Revisao, Estilo, Orcamento, Creditos, RecuperarPix, Gerando, Resultado }
    private Etapa etapa = Etapa.Foto;
    private ApiClient.OfertaPix? ofertaPix;
    private ApiClient.EstadoPix? pix;
    private Guid pedidoPix;
    private string? carteiraPix;
    private string codigoRecuperacaoPix = "";
    private string emailPix = "";
    private string cpfPix = "";
    private string? mensagemPix;
    private bool consultandoPix;
    private bool forcarNovaPix;
    private bool previaPixConfirmada;
    private decimal? precoPixConfirmado;

    private string codigoTv = "";
    private string? controleTv;
    private string? mensagemTv;
    private bool exibirOrcamentoTv;
    private ResultadoFoto? fotoSincronizada;
    private string? fotoTv;

    private int passoEstilo;
    private bool consultandoPrevia;
    private decimal? precoPrevia;

    private ResultadoFoto? foto;
    private string? fotoServidorPath;
    private string? erro;
    private SimulacaoResponse? resultado;

    private bool espelhoAberto, cameraPronta, cameraMultipla, cameraFrontal = true;
    private string? erroCamera;
    private bool iniciarCameraPendente, iniciarComparadorPendente, comparadorFalhou, comparadorPronto;
    private int tentativaComparador;

    private bool salvando, salvo;
    private string? avisoSalvar;
    private string? avisoCompartilhar;

    private bool faseEnvio = true;
    private int indiceMensagem;
    private bool cancelamentoManual;
    private CancellationTokenSource? geracaoCts;
    private static readonly TimeSpan TempoLimiteGeracao = TimeSpan.FromMinutes(4);

    // Formato brasileiro fixo (1.890,00), sem depender da cultura/ICU do servidor.
    private static readonly System.Globalization.NumberFormatInfo PtBr = new() { NumberDecimalSeparator = ",", NumberGroupSeparator = "." };

    private DotNetObjectReference<Captura>? selfRef;

    // ── Catálogo de opções (mesmos valores do original) ──────────────────────
    private readonly List<string> comprimentos = new() { "30 cm", "40 cm", "45 cm", "55 cm", "65 cm", "75 cm", "85 cm" };
    private readonly List<string> cores = new() { "Preto", "Castanho Escuro", "Castanho Claro", "Loiro Escuro", "Loiro Médio", "Loiro Claro", "Loiro Platinado", "Ruivo", "Grisalho" };
    // O backend também aceita "Crespo"; a especificação desta tela pede três opções.
    private readonly List<string> tipos = new() { "Liso", "Ondulado", "Cacheado" };
    private List<string> metodos = new() { "Fita Adesiva", "Queratina", "Micro Link", "Costurado" };

    private string comprimento = "55 cm";
    private string cor = "Castanho Escuro";
    private string tipoCabelo = "Liso";
    private string metodo = "Fita Adesiva";
    private int? quantidadeGramas;
    private ApiClient.OpcoesOrcamento? opcoesOrcamento;
    private readonly Dictionary<string, int> extrasSelecionados = new();
    private static readonly ApiClient.OpcaoOrcamento[] OrigensPadrao =
    [
        new("brasileiro-regional", "Brasileiro regional", "grama", null),
        new("brasileiro-do-sul", "Brasileiro do Sul", "grama", null),
        new("indiano", "Indiano", "grama", null),
        new("russo", "Russo", "grama", null),
        new("vietnamita", "Vietnamita", "grama", null)
    ];
    private ApiClient.OpcaoOrcamento[] origensDisponiveis =>
        opcoesOrcamento?.Origens is { Length: > 0 } cadastradas ? cadastradas : OrigensPadrao;

    private string origemCabelo = "";

    private record FiltroInfo(string Id, string Nome);
    private static readonly FiltroInfo[] Filtros =
    {
        new("natural", "Natural"), new("soft", "Glow"), new("studio", "Studio"),
        new("golden", "Golden"), new("clean", "Clean"), new("portrait", "Portrait")
    };

    // Tons de cada cor: sombra, base e brilho. Não existem fotos de fios no catálogo
    // (o catálogo do backend são máscaras de comprimento), então as amostras são desenhadas.
    private static readonly Dictionary<string, (string Escuro, string Base, string Claro)> Fios = new()
    {
        ["Preto"] = ("#0F0B0A", "#241A17", "#4A3A34"),
        ["Castanho Escuro"] = ("#2A170F", "#4A2C20", "#7A4A35"),
        ["Castanho Claro"] = ("#5A3622", "#81543A", "#B27A55"),
        ["Loiro Escuro"] = ("#7A5528", "#A47745", "#D2A56B"),
        ["Loiro Médio"] = ("#9A7433", "#C39A5A", "#E8C88C"),
        ["Loiro Claro"] = ("#BF9A55", "#E4C98C", "#F7E6BD"),
        ["Loiro Platinado"] = ("#C9BFA8", "#EDE6D6", "#FBF7EC"),
        ["Ruivo"] = ("#6E2A1A", "#A74A32", "#D9805A"),
        ["Grisalho"] = ("#7D7C77", "#AAA9A3", "#D8D7D1")
    };

    // Estas mensagens não indicam progresso: o backend não informa etapas. Descrevem os cuidados
    // da simulação, sem afirmar que algo já foi concluído.
    private static readonly string[] MensagensCarregamento =
    {
        "Preparando sua transformação…",
        "Cuidando do caimento natural dos fios…",
        "Cuidando para preservar seu rosto e o fundo da foto…",
        "Aplicando a cor e o comprimento escolhidos…",
        "Ajustando o volume e o movimento dos cabelos…",
        "Finalizando sua simulação de mega hair…"
    };

    public sealed class ResultadoFoto
    {
        public bool Ok { get; set; }
        public string? Codigo { get; set; }
        public int Largura { get; set; } = 2;
        public int Altura { get; set; } = 3;
        public string? UrlNatural { get; set; }
        public string? UrlFiltrada { get; set; }
        public string? Filtro { get; set; }
        public string? FiltroNome { get; set; }
        public string? Origem { get; set; }
        public bool Ajustada { get; set; }
    }

    private sealed class ResultadoCamera
    {
        public bool Ok { get; set; }
        public string? Codigo { get; set; }
        public bool Multiplas { get; set; }
        public bool Frontal { get; set; }
    }

    private sealed class ResultadoSalvar
    {
        public bool Ok { get; set; }
        public string? Metodo { get; set; }
        public string? Motivo { get; set; }
    }

    private sealed class ResultadoComparador
    {
        public bool Ok { get; set; }
        public bool Desalinhado { get; set; }
    }

    // ── Ciclo de vida ────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(ComprimentoSugerido) && comprimentos.Contains(ComprimentoSugerido)) comprimento = ComprimentoSugerido;
        if (!string.IsNullOrWhiteSpace(CorSugerida) && cores.Contains(CorSugerida)) cor = CorSugerida;
        if (!string.IsNullOrWhiteSpace(TipoSugerido) && tipos.Contains(TipoSugerido)) tipoCabelo = TipoSugerido;
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(6));
        opcoesOrcamento = await Api.ObterOpcoesOrcamentoAsync(timeout.Token);
        foreach (var item in opcoesOrcamento?.Extras ?? []) extrasSelecionados[item.Id] = 0;
        if (opcoesOrcamento?.Metodos is { Length: > 0 } metodosCadastrados)
        {
            metodos = metodosCadastrados.ToList();
            if (!metodos.Contains(metodo)) metodo = metodos[0];
        }
        if (!string.IsNullOrWhiteSpace(MetodoSugerido) && metodos.Contains(MetodoSugerido)) metodo = MetodoSugerido;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("megaHairEspelho.registrarArquivo", "mh-arquivo", selfRef);
        }

        await AtualizarTvAsync();

        if (iniciarCameraPendente)
        {
            iniciarCameraPendente = false;
            await IniciarCameraAsync();
        }

        if (iniciarComparadorPendente)
        {
            iniciarComparadorPendente = false;
            var atual = resultado;
            var tentativa = tentativaComparador;
            var carregou = false;
            try
            {
                var r = await JS.InvokeAsync<ResultadoComparador>("megaHairResultado.iniciarComparador", "mh-comp-wrap");
                carregou = r.Ok;
            }
            catch (JSException) { }

            if (etapa == Etapa.Resultado && resultado == atual && tentativaComparador == tentativa)
            {
                comparadorPronto = carregou;
                comparadorFalhou = !carregou;
                StateHasChanged();
            }
        }
    }

    // ── Espelho Virtual ──────────────────────────────────────────────────────
    private Task AbrirEspelhoAsync()
    {
        erro = null; erroCamera = null; cameraPronta = false;
        espelhoAberto = true;
        iniciarCameraPendente = true; // inicia depois de o <canvas> existir no DOM
        return Task.CompletedTask;
    }

    private async Task IniciarCameraAsync()
    {
        cameraPronta = false;
        var r = await JS.InvokeAsync<ResultadoCamera>("megaHairEspelho.iniciar", "mh-preview", "mh-video", cameraFrontal);
        if (!r.Ok)
        {
            erroCamera = string.IsNullOrWhiteSpace(r.Codigo) ? "erro" : r.Codigo;
        }
        else
        {
            erroCamera = null; cameraPronta = true; cameraMultipla = r.Multiplas;
            await JS.InvokeVoidAsync("megaHairEspelho.ligarControles", "mh-controles");
        }
        StateHasChanged();
    }

    private async Task TentarCameraNovamenteAsync()
    {
        erroCamera = null;
        await IniciarCameraAsync();
    }

    private async Task AlternarCameraAsync()
    {
        cameraFrontal = !cameraFrontal;
        await IniciarCameraAsync();
    }

    private async Task CapturarAsync()
    {
        if (!cameraPronta) return;
        await JS.InvokeVoidAsync("megaHairEspelho.feedbackCaptura", "mh-palco");
        var r = await JS.InvokeAsync<ResultadoFoto>("megaHairEspelho.capturar");
        if (!r.Ok)
        {
            erro = "Não foi possível capturar a foto. Tente novamente.";
            erroCamera = "erro";
            return;
        }
        await JS.InvokeVoidAsync("megaHairEspelho.parar");
        foto = r; fotoServidorPath = null; resultado = null;
        espelhoAberto = false; cameraPronta = false; erro = null;
        etapa = Etapa.Revisao;
    }

    private async Task FecharEspelhoAsync()
    {
        await JS.InvokeVoidAsync("megaHairEspelho.parar");
        espelhoAberto = false; cameraPronta = false; erroCamera = null;
    }

    // Chamado pelo JavaScript quando a cliente escolhe uma foto da galeria.
    [JSInvokable]
    public async Task AoProcessarArquivo(ResultadoFoto r)
    {
        await InvokeAsync(async () =>
        {
            if (espelhoAberto)
            {
                await JS.InvokeVoidAsync("megaHairEspelho.parar");
                espelhoAberto = false; cameraPronta = false; erroCamera = null;
            }

            if (!r.Ok)
            {
                erro = r.Codigo switch
                {
                    "formato" => "Não consegui ler essa imagem. Use uma foto em JPG, PNG ou WEBP.",
                    "grande" => "Essa foto é muito grande. Escolha uma imagem de até 25 MB.",
                    _ => "Não foi possível carregar essa foto. Tente outra."
                };
                if (etapa != Etapa.Estilo) etapa = Etapa.Foto;
                StateHasChanged();
                return;
            }

            foto = r; fotoServidorPath = null; resultado = null; erro = null;
            etapa = Etapa.Revisao;
            StateHasChanged();
        });
    }

    private static string MensagemErroCamera(string codigo) => codigo switch
    {
        "permissao" => "Precisamos da sua permissão para usar a câmera. Permita o acesso à câmera nas configurações do navegador e tente novamente.",
        "sem-camera" => "Não encontramos uma câmera neste aparelho. Você pode escolher uma foto da galeria.",
        "em-uso" => "A câmera está sendo usada por outro aplicativo. Feche-o e tente novamente.",
        "inseguro" => "A câmera só funciona em conexão segura (https). Você pode escolher uma foto da galeria.",
        "sem-suporte" => "Este navegador não permite abrir a câmera. Você pode escolher uma foto da galeria.",
        _ => "Algo deu errado ao abrir a câmera. Tente novamente ou escolha uma foto da galeria."
    };

    // ── Revisão e navegação ──────────────────────────────────────────────────
    private async Task ParearTvAsync()
    {
        if ((await Auth.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated != true)
            return;

        controleTv = Salao.Parear(codigoTv.Trim());
        mensagemTv = controleTv is null ? "Código inválido, usado ou expirado. Confira o código na TV." : null;
        codigoTv = "";
    }

    private void DesconectarTv()
    {
        if (controleTv is not null) Salao.Encerrar(controleTv);
        controleTv = null;
        fotoSincronizada = null;
        fotoTv = null;
        exibirOrcamentoTv = false;
    }

    private async Task EncerrarTvAsync()
    {
        DesconectarTv();
        geracaoCts?.Cancel();
        await NovaSimulacaoAsync();
    }

    private async Task AtualizarTvAsync()
    {
        if (controleTv is not { } controle) return;
        if ((await Auth.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated != true)
        {
            DesconectarTv();
            return;
        }

        var atual = etapa is Etapa.Foto or Etapa.Revisao ? null : foto;
        if (atual != fotoSincronizada)
        {
            fotoSincronizada = atual;
            fotoTv = null;
            exibirOrcamentoTv = false;
            if (atual?.UrlNatural is { } url)
            {
                try
                {
                    var previa = await JS.InvokeAsync<string?>("megaHairResultado.fotoParaTv", url);
                    if (controle != controleTv || atual != fotoSincronizada || atual != foto) return;
                    fotoTv = previa is { Length: <= 650000 } ? previa : null;
                }
                catch (JSException) { }
            }
        }

        var final = etapa == Etapa.Resultado && comparadorPronto ? resultado : null;
        if (final is null) exibirOrcamentoTv = false;
        var estilo = atual is null ? null : $"{comprimento} · {cor} · {tipoCabelo}";
        var orcamento = exibirOrcamentoTv && final is { PrecoMegaHairProIndisponivel: false } && quantidadeGramas is > 0
            ? $"Estimativa do mega hair: R$ {final.ValorEstimado.ToString("N2", PtBr)} · {NotaSobConsulta()}"
            : null;
        var fase = etapa == Etapa.Gerando ? "gerando" : "pronto";
        if (!Salao.Mostrar(controle, new(fase, fotoTv ?? final?.FotoOriginalUrl,
                final?.FotoResultadoUrl, estilo, orcamento)))
        {
            DesconectarTv();
            mensagemTv = "A sessão da TV expirou. Use o novo código que aparece na TV.";
            StateHasChanged();
        }
    }

    private void UsarFoto()
    {
        erro = null; passoEstilo = 0; etapa = Etapa.Estilo;
    }

    private async Task RefazerFotoAsync()
    {
        var eraCamera = foto?.Origem == "camera";
        await JS.InvokeVoidAsync("megaHairEspelho.liberar");
        foto = null; fotoServidorPath = null; resultado = null; erro = null;
        etapa = Etapa.Foto;
        if (eraCamera) await AbrirEspelhoAsync();
    }

    private async Task TrocarFotoAsync()
    {
        await JS.InvokeVoidAsync("megaHairEspelho.liberar");
        foto = null; fotoServidorPath = null; resultado = null; erro = null;
        etapa = Etapa.Foto;
    }

    private void Avancar() { if (passoEstilo < 2) passoEstilo++; }
    private void Voltar() { if (passoEstilo > 0) passoEstilo--; }

    private string ClassePasso(int i) => i < passoEstilo ? "mh-feito" : i == passoEstilo ? "mh-atual" : "";

    private static string SvgTextura(string tipo)
    {
        const string cabeca = "<svg viewBox=\"0 0 60 90\" class=\"mh-textura-svg\" aria-hidden=\"true\" focusable=\"false\">";
        var fios = tipo switch
        {
            "Ondulado" =>
                "<path d=\"M10 6 C 20 18, 0 30, 10 42 S 20 66, 10 84\"/><path d=\"M22 6 C 32 18, 12 30, 22 42 S 32 66, 22 84\"/>" +
                "<path d=\"M34 6 C 44 18, 24 30, 34 42 S 44 66, 34 84\"/><path d=\"M46 6 C 56 18, 36 30, 46 42 S 56 66, 46 84\"/>",
            "Cacheado" =>
                "<path d=\"M10 6 c8 0 8 8 0 8 s-8 8 0 8 s8 8 0 8 s-8 8 0 8 s8 8 0 8 s-8 8 0 8 s8 8 0 8\"/>" +
                "<path d=\"M24 6 c8 0 8 8 0 8 s-8 8 0 8 s8 8 0 8 s-8 8 0 8 s8 8 0 8 s-8 8 0 8 s8 8 0 8\"/>" +
                "<path d=\"M38 6 c8 0 8 8 0 8 s-8 8 0 8 s8 8 0 8 s-8 8 0 8 s8 8 0 8 s-8 8 0 8 s8 8 0 8\"/>" +
                "<path d=\"M52 6 c8 0 8 8 0 8 s-8 8 0 8 s8 8 0 8 s-8 8 0 8 s8 8 0 8 s-8 8 0 8 s8 8 0 8\"/>",
            _ =>
                "<path d=\"M10 6 C 9 30, 11 60, 10 84\"/><path d=\"M22 6 C 21 30, 23 60, 22 84\"/>" +
                "<path d=\"M34 6 C 33 30, 35 60, 34 84\"/><path d=\"M46 6 C 45 30, 47 60, 46 84\"/>"
        };
        return cabeca + "<g class=\"mh-fios\">" + fios + "</g></svg>";
    }

    // ── Geração ──────────────────────────────────────────────────────────────
    private async Task ConfirmarEscolhasAsync()
    {
        if (consultandoPrevia || etapa != Etapa.Estilo || foto is null) return;
        if (!EscolhasValidas()) return;

        var fotoAtual = foto;
        var escolhas = (metodo, quantidadeGramas, origemCabelo);
        var extras = new Dictionary<string, int>(extrasSelecionados);
        consultandoPrevia = true;
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(7));
            var previa = await Api.ConsultarPreviaOrcamentoAsync(
                escolhas.metodo, escolhas.quantidadeGramas, escolhas.origemCabelo, extras, timeout.Token);
            if (etapa != Etapa.Estilo || passoEstilo != 2 || foto != fotoAtual
                || escolhas != (metodo, quantidadeGramas, origemCabelo)
                || extras.Any(item => extrasSelecionados[item.Key] != item.Value))
                return;

            if (previa.Ativo)
            {
                precoPrevia = previa.ValorTotal;
                etapa = Etapa.Orcamento;
            }
            else
            {
                await GerarSimulacaoAsync(forcarNova: false);
            }
        }
        finally
        {
            consultandoPrevia = false;
        }
    }

    private bool EscolhasValidas()
    {
        if (extrasSelecionados.Values.Any(quantidade => quantidade is < 0 or > 100))
        {
            erro = "Informe entre 0 e 100 unidades para cada item opcional.";
            return false;
        }

        if (!quantidadeGramas.HasValue || (quantidadeGramas is > 0 and <= 5000 && !string.IsNullOrEmpty(origemCabelo)))
            return true;

        erro = "Selecione a origem do cabelo e informe uma quantidade entre 1 e 5.000 gramas.";
        return false;
    }

    private async Task GerarSimulacaoAsync(bool forcarNova)
    {
        if (foto is null || etapa == Etapa.Gerando) return;

        if (!EscolhasValidas()) return;

        var previaConfirmada = etapa == Etapa.Orcamento || (etapa == Etapa.Creditos && previaPixConfirmada);
        var precoConfirmado = etapa == Etapa.Orcamento ? precoPrevia : etapa == Etapa.Creditos ? precoPixConfirmado : null;

        geracaoCts?.Cancel();
        geracaoCts = new CancellationTokenSource();
        var cts = geracaoCts;
        cts.CancelAfter(TempoLimiteGeracao);
        var ct = cts.Token;

        erro = null; resultado = null; avisoCompartilhar = null; comparadorFalhou = false; salvo = false; avisoSalvar = null;
        faseEnvio = string.IsNullOrWhiteSpace(fotoServidorPath);
        indiceMensagem = 0;
        cancelamentoManual = false;
        etapa = Etapa.Gerando;
        StateHasChanged();
        _ = CiclarMensagensAsync(ct);

        try
        {
            if (string.IsNullOrWhiteSpace(fotoServidorPath))
            {
                // Sempre a foto NATURAL (sem efeitos): preserva a cor real do cabelo para a IA.
                var bytes = await JS.InvokeAsync<byte[]?>("megaHairEspelho.obterBytes", ct);
                if (bytes is null || bytes.Length == 0)
                    throw new InvalidOperationException("Não encontrei a foto. Escolha ou tire a foto novamente.");
                fotoServidorPath = await Api.UploadFotoAsync(bytes, $"foto_{Guid.NewGuid():N}.jpg", ct);
            }

            faseEnvio = false;
            await InvokeAsync(StateHasChanged);

            var request = new CriarSimulacaoRequest
            {
                FotoOriginalPath = fotoServidorPath,
                Comprimento = comprimento,
                Cor = cor,
                TipoCabelo = tipoCabelo,
                MetodoMegaHair = metodo,
                QuantidadeGramas = quantidadeGramas,
                OrigemCabelo = origemCabelo,
                ExtrasOrcamento = new(extrasSelecionados),
                PreviaConfirmada = previaConfirmada,
                PrecoConfirmado = precoConfirmado,
                Provider = SimuladorMegaHair.Domain.Enums.ImageProvider.OpenAI,
                ClienteId = Guid.TryParse(ClienteId, out var cid) ? cid : null,
                ForcarNovaGeracao = forcarNova
            };
            if (carteiraPix is null)
            {
                try { carteiraPix = await JS.InvokeAsync<string>("megaHairResultado.carteiraPix"); }
                catch (JSException) { }
            }
            resultado = await Api.CriarSimulacaoAsync(request, ct, carteiraPix);

            if (resultado is null || string.IsNullOrWhiteSpace(resultado.FotoResultadoUrl))
                throw new InvalidOperationException("A simulação não retornou imagem.");

            etapa = Etapa.Resultado;
            RecarregarComparador();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Gone)
        {
            fotoServidorPath = null;
            etapa = Etapa.Estilo;
            passoEstilo = 2;
            erro = "A autorização da foto expirou. Toque em Transformar meu visual para enviá-la novamente.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.PaymentRequired)
        {
            etapa = Etapa.Estilo;
            passoEstilo = 2;
            erro = "Sua geração gratuita está indisponível. Fale com o salão para continuar.";
            previaPixConfirmada = previaConfirmada;
            precoPixConfirmado = precoConfirmado;
            await AbrirCreditosAsync(forcarNova);
        }
        catch (OperationCanceledException)
        {
            // Cancelada pela cliente, ou estourou o tempo limite.
            etapa = Etapa.Estilo; passoEstilo = 2;
            erro = cancelamentoManual ? null : "A simulação demorou mais do que o esperado. Vamos tentar de novo?";
        }
        catch (Exception ex)
        {
            etapa = Etapa.Estilo; passoEstilo = 2;
            erro = MensagemDeErro(ex);
        }
        finally
        {
            cts.Cancel(); // encerra o ciclo de mensagens
        }
    }

    private void AbrirRecuperacaoPix()
    {
        mensagemPix = null;
        codigoRecuperacaoPix = "";
        previaPixConfirmada = false;
        precoPixConfirmado = null;
        etapa = Etapa.RecuperarPix;
    }

    private async Task RecuperarCarteiraAsync()
    {
        var codigo = codigoRecuperacaoPix.Trim().ToLowerInvariant();
        if (consultandoPix) return;
        if (codigo.Length != 64 || !codigo.All(char.IsAsciiHexDigit))
        {
            mensagemPix = "Confira o código da carteira.";
            return;
        }

        consultandoPix = true;
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            var recuperada = await Api.RecuperarPixAsync(codigo, timeout.Token);
            if (recuperada is null)
            {
                mensagemPix = "Carteira não encontrada.";
                return;
            }
            await JS.InvokeVoidAsync("megaHairResultado.restaurarCarteiraPix", codigo, recuperada.Pedido?.ToString());
            carteiraPix = codigo;
            codigoRecuperacaoPix = "";
            VoltarDoPix();
            if (recuperada.Saldo <= 0 && recuperada.Pedido.HasValue)
            {
                consultandoPix = false;
                await AbrirCreditosAsync(false);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or JSException or System.Text.Json.JsonException)
        {
            mensagemPix = "Não foi possível recuperar a carteira agora.";
        }
        finally { consultandoPix = false; }
    }

    private async Task AbrirCreditosAsync(bool forcarNova)
    {
        if (carteiraPix is null) return;
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            ofertaPix = await Api.ObterOfertaPixAsync(timeout.Token);
            if (ofertaPix is not { Ativo: true }) return;
            var salvo = await JS.InvokeAsync<string?>("megaHairResultado.pedidoPix");
            Guid.TryParse(salvo, out pedidoPix);
            pix = null;
            mensagemPix = null;
            forcarNovaPix = forcarNova;
            etapa = Etapa.Creditos;
            if (pedidoPix != Guid.Empty) await VerificarPixAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or JSException or System.Text.Json.JsonException) { }
    }

    private Task CriarPixAsync() => ProcessarPixAsync(criar: true);
    private Task VerificarPixAsync() => ProcessarPixAsync(criar: false);

    private void VoltarDoPix()
    {
        etapa = Etapa.Estilo;
        passoEstilo = 2;
        erro = null;
    }

    private async Task ProcessarPixAsync(bool criar)
    {
        if (consultandoPix || carteiraPix is null) return;
        var cpf = new string(cpfPix.Where(char.IsAsciiDigit).ToArray());
        if (criar && (string.IsNullOrWhiteSpace(emailPix) || cpf.Length != 11))
        {
            mensagemPix = "Confira o e-mail e informe os 11 dígitos do CPF.";
            return;
        }
        if (!criar && pedidoPix == Guid.Empty) return;
        consultandoPix = true;
        mensagemPix = null;
        try
        {
            if (pedidoPix == Guid.Empty)
            {
                pedidoPix = Guid.NewGuid();
                await JS.InvokeVoidAsync("megaHairResultado.pedidoPix", pedidoPix.ToString());
            }
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            pix = await Api.ConsultarPixAsync(carteiraPix, pedidoPix, criar ? emailPix.Trim() : null, cpf, ofertaPix, timeout.Token);
            if (pix?.Status is "approved" or "cancelled" or "rejected" or "refunded")
            {
                await JS.InvokeVoidAsync("megaHairResultado.pedidoPix", "");
                pedidoPix = Guid.Empty;
                emailPix = "";
                cpfPix = "";
                if (pix.Status != "approved")
                    mensagemPix = "O pagamento não foi aprovado. Você pode gerar outro Pix.";
            }
            else
                mensagemPix = "Aguardando confirmação pelo Mercado Pago.";
        }
        catch (ApiClient.OfertaPixAlteradaException ex)
        {
            ofertaPix = ex.Oferta;
            mensagemPix = "A oferta foi atualizada. Confira o preço e a quantidade antes de gerar o Pix.";
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or JSException or System.Text.Json.JsonException)
        {
            mensagemPix = "Não foi possível verificar o Pix agora. Tente novamente antes de fazer outro pagamento.";
        }
        finally { consultandoPix = false; }
    }

    private const string MensagemPadrao = "Não conseguimos gerar a simulação desta vez. Vamos tentar novamente?";

    // Traduz falhas técnicas em mensagens para a cliente: nunca mostra JSON, endereço interno ou stack.
    private string MensagemDeErro(Exception ex)
    {
        if (ex is HttpRequestException http)
        {
            var codigo = http.StatusCode is null ? 0 : (int)http.StatusCode.Value;
            if (codigo is 401 or 403 or 405) return ApiClient.MensagemAmigavel(ex, MensagemPadrao, Api.BaseAddress);
            if (codigo >= 400 && codigo < 500) return ExtrairMensagemDaApi(http.Message) ?? MensagemPadrao;
            if (codigo >= 500) return "Tivemos um problema para gerar sua simulação. Tente novamente em instantes.";
            return "Não conseguimos nos conectar ao servidor. Verifique sua internet e tente novamente.";
        }
        if (ex is InvalidOperationException && !string.IsNullOrWhiteSpace(ex.Message)) return ex.Message;
        return MensagemPadrao;
    }

    // O ApiClient lança "API 422: {\"erro\":\"...\"}". Aqui devolvemos só o texto do campo de erro.
    private static string? ExtrairMensagemDaApi(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return null;
        var corpo = texto.StartsWith("API ", StringComparison.Ordinal) && texto.IndexOf(": ", StringComparison.Ordinal) is var i and > 0
            ? texto[(i + 2)..].Trim()
            : texto.Trim();
        if (corpo.StartsWith('{'))
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(corpo);
                foreach (var nome in new[] { "erro", "mensagem", "message", "detail", "title" })
                {
                    foreach (var prop in doc.RootElement.EnumerateObject())
                    {
                        if (string.Equals(prop.Name, nome, StringComparison.OrdinalIgnoreCase)
                            && prop.Value.ValueKind == System.Text.Json.JsonValueKind.String
                            && !string.IsNullOrWhiteSpace(prop.Value.GetString()))
                            return prop.Value.GetString();
                    }
                }
            }
            catch (System.Text.Json.JsonException) { }
            return null;
        }
        return corpo.Length is > 0 and <= 220 && !corpo.Contains('<') ? corpo : null;
    }

    private void CancelarGeracao()
    {
        cancelamentoManual = true;
        geracaoCts?.Cancel();
    }

    private async Task CiclarMensagensAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(4200, ct);
                indiceMensagem++;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

