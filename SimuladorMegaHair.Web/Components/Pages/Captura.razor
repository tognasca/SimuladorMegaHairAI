@page "/captura"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ApiClient Api
<PageTitle>Sua transformação — Tati Mega Hair</PageTitle>

<div class="mh-app">

    @* O seletor de arquivo fica SEMPRE no DOM: o <label for> abre a galeria direto
       (gesto nativo do toque), e o JS processa a foto assim que ela é escolhida. *@
    <input id="mh-arquivo" class="mh-oculto-visual" type="file" accept="image/*" tabindex="-1" aria-hidden="true" />

    @* ─────────────────────────────  1. SUA FOTO  ───────────────────────────── *@
    @if (etapa == Etapa.Foto)
    {
        <section class="mh-tela mh-tela-foto">
            <ol class="mh-passos" aria-label="Etapas">
                <li class="mh-atual">Sua foto</li><li>Comprimento</li><li>Cor</li><li>Textura</li><li>Transformação</li>
            </ol>

            <h1 class="mh-titulo">✨ Sua transformação começa aqui</h1>
            <p class="mh-subtitulo">Descubra como você ficaria com o mega hair dos seus sonhos.</p>
            @if (!string.IsNullOrWhiteSpace(ClienteNome))
            {
                <p class="mh-cliente">Simulação para <strong>@ClienteNome</strong></p>
            }

            <div class="mh-moldura" aria-hidden="true">
                <svg viewBox="0 0 200 300" focusable="false">
                    <ellipse cx="100" cy="88" rx="36" ry="46" class="mh-moldura-rosto" />
                    <path d="M18 300 C 20 205, 62 168, 100 168 C 138 168, 180 205, 182 300" class="mh-moldura-ombros" />
                    <path d="M66 76 C 40 112, 52 196, 28 272 M134 76 C 160 112, 148 196, 172 272" class="mh-moldura-fios" /><path d="M72 70 C 52 108, 62 190, 44 262 M128 70 C 148 108, 138 190, 156 262" class="mh-moldura-fios mh-moldura-fios-2" />
                    <g class="mh-brilho"><path d="M164 40 l4 10 l10 4 l-10 4 l-4 10 l-4 -10 l-10 -4 l10 -4z" /></g>
                </svg>
            </div>

            @if (!string.IsNullOrEmpty(erro))
            {
                <div class="mh-alerta" role="alert">@erro</div>
            }

            <div class="mh-acoes-principais">
                <button type="button" class="mh-btn mh-btn-primario" @onclick="AbrirEspelhoAsync">📸 TIRAR FOTO</button>
                <label for="mh-arquivo" class="mh-btn mh-btn-secundario" role="button" tabindex="0">🖼️ ESCOLHER DA GALERIA</label>
            </div>
            <p class="mh-nota">Use uma foto de frente, com boa iluminação, mostrando rosto e ombros.</p>
        </section>
    }

    @* ─────────────────────────────  REVISÃO DA FOTO  ───────────────────────────── *@
    @if (etapa == Etapa.Revisao && foto is not null)
    {
        <section class="mh-tela mh-tela-revisao">
            <h2 class="mh-titulo mh-titulo-menor">Ficou do jeito que você quer?</h2>
            <div class="mh-revisao-foto" style="--ar:@foto.Largura / @foto.Altura">
                <img src="@(foto.UrlFiltrada ?? foto.UrlNatural)" alt="Sua foto" />
                @if (foto.UrlFiltrada is not null)
                {
                    <span class="mh-selo">Efeito: @foto.FiltroNome</span>
                }
            </div>
            @if (foto.UrlFiltrada is not null)
            {
                <p class="mh-nota">Para um resultado fiel, a simulação usa a sua foto <strong>natural</strong>, sem efeitos. Assim a cor real do seu cabelo é preservada.</p>
            }
            @if (foto.Ajustada)
            {
                <p class="mh-nota">Ajustamos o enquadramento da foto para o formato retrato.</p>
            }
            <div class="mh-acoes-principais">
                <button type="button" class="mh-btn mh-btn-primario" @onclick="UsarFoto">Usar esta foto</button>
                <button type="button" class="mh-btn mh-btn-secundario" @onclick="RefazerFotoAsync">↺ Refazer a foto</button>
            </div>
        </section>
    }

    @* ─────────────────────────────  2–4. ESCOLHAS  ───────────────────────────── *@
    @if (etapa == Etapa.Estilo && foto is not null)
    {
        <section class="mh-tela mh-tela-estilo">
            <ol class="mh-passos" aria-label="Etapas">
                <li class="mh-feito">Sua foto</li>
                <li class="@ClassePasso(0)">Comprimento</li>
                <li class="@ClassePasso(1)">Cor</li>
                <li class="@ClassePasso(2)">Textura</li>
                <li>Transformação</li>
            </ol>

            <div class="mh-resumo">
                <img src="@foto.UrlNatural" alt="Sua foto" class="mh-resumo-foto" />
                <div class="mh-resumo-texto">
                    <span>@comprimento · @cor · @tipoCabelo</span>
                    <button type="button" class="mh-link" @onclick="TrocarFotoAsync">Trocar foto</button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(erro))
            {
                <div class="mh-alerta" role="alert">
                    @erro
                    <button type="button" class="mh-link" @onclick="() => erro = null">Fechar</button>
                </div>
            }

            @if (passoEstilo == 0)
            {
                <h2 class="mh-titulo mh-titulo-menor">Qual comprimento você sonha?</h2>
                <div class="mh-comprimento-visual" aria-hidden="true">
                    <svg viewBox="0 0 120 190" focusable="false">
                        <circle cx="60" cy="34" r="17" class="mh-sil" />
                        <path d="M44 56 C 20 62, 12 82, 10 190 L110 190 C 108 82, 100 62, 76 56 C 70 62, 50 62, 44 56Z" class="mh-sil" />
                        <g class="mh-regua" style="transform:translateY(@(OffsetComprimento())px)">
                            <line x1="6" x2="114" y1="0" y2="0" />
                            <circle cx="60" cy="0" r="4" />
                        </g>
                    </svg>
                    <div class="mh-comprimento-info">
                        <strong>@comprimento</strong>
                        <span>@AlturaDescricao(comprimento)</span>
                        <small>Ilustração aproximada</small>
                    </div>
                </div>
                <div class="mh-chips mh-chips-rolagem" role="radiogroup" aria-label="Comprimento">
                    @foreach (var c in comprimentos)
                    {
                        <button type="button" role="radio" aria-checked="@(comprimento == c ? "true" : "false")"
                                class="mh-chip @(comprimento == c ? "mh-sel" : "")" @onclick="() => comprimento = c">@c</button>
                    }
                </div>
            }
            else if (passoEstilo == 1)
            {
                <h2 class="mh-titulo mh-titulo-menor">Escolha a cor</h2>
                <div class="mh-cores" role="radiogroup" aria-label="Cor">
                    @foreach (var c in cores)
                    {
                        var t = Fios[c];
                        <button type="button" role="radio" aria-checked="@(cor == c ? "true" : "false")"
                                class="mh-cor @(cor == c ? "mh-sel" : "")" @onclick="() => cor = c"
                                style="--fio-escuro:@t.Escuro; --fio-base:@t.Base; --fio-claro:@t.Claro">
                            <span class="mh-cor-fios"></span>
                            <span class="mh-cor-nome">@c</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <h2 class="mh-titulo mh-titulo-menor">Escolha a textura</h2>
                <div class="mh-texturas" role="radiogroup" aria-label="Textura">
                    @foreach (var t in tipos)
                    {
                        <button type="button" role="radio" aria-checked="@(tipoCabelo == t ? "true" : "false")"
                                class="mh-textura @(tipoCabelo == t ? "mh-sel" : "")" @onclick="() => tipoCabelo = t">
                            @((MarkupString)SvgTextura(t))
                            <span>@t</span>
                        </button>
                    }
                </div>

                <div class="mh-metodo">
                    <span class="mh-metodo-titulo">Método de aplicação</span>
                    <div class="mh-chips" role="radiogroup" aria-label="Método de aplicação">
                        @foreach (var m in metodos)
                        {
                            <button type="button" role="radio" aria-checked="@(metodo == m ? "true" : "false")"
                                    class="mh-chip mh-chip-pequeno @(metodo == m ? "mh-sel" : "")" @onclick="() => metodo = m">@m</button>
                        }
                    </div>
                </div>
            }

            <div class="mh-rodape-fixo">
                @if (passoEstilo > 0)
                {
                    <button type="button" class="mh-btn mh-btn-secundario mh-btn-voltar" @onclick="Voltar" aria-label="Voltar">←</button>
                }
                @if (passoEstilo < 2)
                {
                    <button type="button" class="mh-btn mh-btn-primario" @onclick="Avancar">Continuar</button>
                }
                else
                {
                    <button type="button" class="mh-btn mh-btn-primario" @onclick="() => GerarSimulacaoAsync(forcarNova: false)">✨ Transformar meu visual</button>
                }
            </div>
        </section>
    }

    @* ─────────────────────────────  GERANDO  ───────────────────────────── *@
    @if (etapa == Etapa.Gerando)
    {
        <section class="mh-carregando" role="status" aria-live="polite">
            @if (foto is not null)
            {
                <div class="mh-carregando-fundo" style="background-image:url('@foto.UrlNatural')"></div>
            }
            <div class="mh-carregando-miolo">
                <div class="mh-anel" aria-hidden="true"><span>✦</span></div>
                <h2 class="mh-titulo mh-titulo-menor">✨ Estamos preparando seu novo visual</h2>
                <p class="mh-fase">@(faseEnvio ? "Enviando sua foto…" : "Gerando sua simulação…")</p>
                <p class="mh-dica" aria-hidden="true">@MensagensCarregamento[indiceMensagem % MensagensCarregamento.Length]</p>
                <div class="mh-barra-indeterminada" aria-hidden="true"><span></span></div>
                <small>Isso costuma levar cerca de 1 minuto. Não feche esta tela.</small>
                <button type="button" class="mh-link" @onclick="CancelarGeracao">Cancelar</button>
            </div>
        </section>
    }

    @* ─────────────────────────────  RESULTADO  ───────────────────────────── *@
    @if (etapa == Etapa.Resultado && resultado is not null)
    {
        <section class="mh-tela mh-tela-resultado">
            <h2 class="mh-titulo">✨ Seu novo visual está pronto!</h2>

            <div class="mh-comp-wrap" id="mh-comp-wrap" style="--ar:0.6667">
                <div class="mh-comp" tabindex="-1">
                    <div class="mh-comp-stage">
                        <img class="mh-comp-img mh-comp-antes" src="@(foto?.UrlNatural ?? resultado.FotoOriginalUrl)" alt="Antes" draggable="false" />
                        <img class="mh-comp-img mh-comp-depois" src="@resultado.FotoResultadoUrl" alt="Depois" draggable="false" />
                    </div>
                    <div class="mh-comp-handle" role="slider" tabindex="0" aria-label="Comparar antes e depois"
                         aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
                        <span class="mh-comp-knob" aria-hidden="true">‹ ›</span>
                    </div>
                    <span class="mh-comp-tag mh-comp-tag-antes">Antes</span>
                    <span class="mh-comp-tag mh-comp-tag-depois">Depois</span>
                    <div class="mh-comp-tools">
                        <button type="button" data-acao="zoom-mais" aria-label="Aproximar">+</button>
                        <button type="button" data-acao="zoom-menos" aria-label="Afastar">−</button>
                        <button type="button" data-acao="restaurar" aria-label="Restaurar enquadramento">⟲</button>
                        <button type="button" data-acao="tela-cheia" aria-label="Tela cheia">⛶</button>
                    </div>
                </div>
                <p class="mh-comp-legenda">Arraste para comparar · pinça ou toque duplo para ampliar</p>
            </div>

            @if (comparadorFalhou)
            {
                <div class="mh-alerta" role="alert">Não consegui carregar as imagens do resultado. <button type="button" class="mh-link" @onclick="() => GerarSimulacaoAsync(forcarNova: false)">Tentar de novo</button></div>
            }

            <div class="mh-resultado-meta">
                <span>@metodo · @comprimento · @cor · @tipoCabelo</span>
                <strong>Estimativa R$ @resultado.ValorEstimado.ToString("N2", PtBr)</strong>
            </div>

            <div class="mh-acoes-principais">
                <button type="button" class="mh-btn mh-btn-primario @(salvo ? "mh-ok" : "")" disabled="@salvando" @onclick="SalvarAsync">
                    @(salvando ? "Salvando…" : salvo ? "✓ Salvo!" : "💾 Salvar minha transformação")
                </button>
                <button type="button" class="mh-btn mh-btn-secundario" @onclick="ExperimentarOutroVisual">✨ Experimentar outro visual</button>
                <button type="button" class="mh-btn mh-btn-secundario" @onclick="NovaSimulacaoAsync">📸 Fazer nova simulação</button>
            </div>

            @if (!string.IsNullOrEmpty(avisoSalvar))
            {
                <p class="mh-nota" role="status">@avisoSalvar <a href="@resultado.FotoResultadoUrl" target="_blank" rel="noopener">Abrir imagem</a></p>
            }
            <button type="button" class="mh-link mh-link-centro" @onclick="() => GerarSimulacaoAsync(forcarNova: true)">↻ Gerar outra versão deste visual</button>
        </section>
    }

    @* ─────────────────────────────  ESPELHO VIRTUAL (câmera em tela cheia)  ───────────────────────────── *@
    @if (espelhoAberto)
    {
        <div class="mh-espelho" role="dialog" aria-modal="true" aria-label="Espelho Virtual">
            <video id="mh-video" class="mh-video-oculto" playsinline muted autoplay></video>

            <header class="mh-espelho-topo">
                <button type="button" class="mh-icone" @onclick="FecharEspelhoAsync" aria-label="Fechar câmera">✕</button>
                <span class="mh-espelho-titulo">✨ Espelho Virtual</span>
                <button type="button" class="mh-icone @(cameraMultipla ? "" : "mh-invisivel")" @onclick="AlternarCameraAsync"
                        aria-label="Alternar câmera" disabled="@(!cameraMultipla)">⟲</button>
            </header>

            <div class="mh-espelho-meio">
                <div class="mh-palco" id="mh-palco">
                    <canvas id="mh-preview" class="mh-preview"></canvas>
                    <svg class="mh-guia" viewBox="0 0 200 300" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                        <ellipse cx="100" cy="88" rx="38" ry="48" />
                        <path d="M14 300 C 16 205, 58 170, 100 170 C 142 170, 184 205, 186 300" />
                    </svg>
                    <div class="mh-palco-dicas">
                        <span>Posicione seu rosto e ombros dentro da área indicada.</span>
                        <small>Utilize uma boa iluminação para um resultado mais realista.</small>
                    </div>

                    @if (erroCamera is not null)
                    {
                        <div class="mh-camera-erro" role="alert">
                            <strong>Não foi possível abrir a câmera</strong>
                            <p>@MensagemErroCamera(erroCamera)</p>
                            <div class="mh-acoes-principais">
                                @if (erroCamera is not "sem-camera" and not "sem-suporte" and not "inseguro")
                                {
                                    <button type="button" class="mh-btn mh-btn-primario" @onclick="TentarCameraNovamenteAsync">Tentar novamente</button>
                                }
                                <label for="mh-arquivo" class="mh-btn mh-btn-secundario" role="button" tabindex="0">🖼️ Escolher da galeria</label>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <footer class="mh-espelho-base" id="mh-controles">
                <div class="mh-filtros" role="group" aria-label="Efeitos">
                    @foreach (var f in Filtros)
                    {
                        <button type="button" class="mh-filtro" data-filtro="@f.Id" aria-pressed="false">
                            <canvas class="mh-miniatura" data-miniatura="@f.Id" width="56" height="84"></canvas>
                            <span>@f.Nome</span>
                        </button>
                    }
                </div>
                <div class="mh-intensidade mh-sem-efeito">
                    <label for="mh-intensidade-slider">Intensidade</label>
                    <input id="mh-intensidade-slider" type="range" min="0" max="100" step="1" data-intensidade aria-label="Intensidade do efeito" />
                    <button type="button" class="mh-link" data-remover-efeitos>Remover efeitos</button>
                </div>
                <div class="mh-obturador-linha">
                    <button type="button" class="mh-obturador" @onclick="CapturarAsync" disabled="@(erroCamera is not null || !cameraPronta)" aria-label="Tirar foto"><span></span></button>
                </div>
            </footer>
        </div>
    }
</div>

@code {
    // ── Parâmetros de URL (preservados do original) ──────────────────────────
    [SupplyParameterFromQuery, Parameter] public string? ClienteId { get; set; }
    [SupplyParameterFromQuery, Parameter] public string? ClienteNome { get; set; }
    [SupplyParameterFromQuery(Name = "comprimento"), Parameter] public string? ComprimentoSugerido { get; set; }
    [SupplyParameterFromQuery(Name = "cor"), Parameter] public string? CorSugerida { get; set; }
    [SupplyParameterFromQuery(Name = "tipo"), Parameter] public string? TipoSugerido { get; set; }
    [SupplyParameterFromQuery(Name = "metodo"), Parameter] public string? MetodoSugerido { get; set; }

    // ── Estado ───────────────────────────────────────────────────────────────
    private enum Etapa { Foto, Revisao, Estilo, Gerando, Resultado }
    private Etapa etapa = Etapa.Foto;
    private int passoEstilo;

    private ResultadoFoto? foto;
    private string? fotoServidorPath;
    private string? erro;
    private SimulacaoResponse? resultado;

    private bool espelhoAberto, cameraPronta, cameraMultipla, cameraFrontal = true;
    private string? erroCamera;
    private bool iniciarCameraPendente, iniciarComparadorPendente, comparadorFalhou;

    private bool salvando, salvo;
    private string? avisoSalvar;

    private bool faseEnvio = true;
    private int indiceMensagem;
    private bool cancelamentoManual;
    private CancellationTokenSource? geracaoCts;
    private static readonly TimeSpan TempoLimiteGeracao = TimeSpan.FromMinutes(4);

    // Formato brasileiro fixo (1.890,00), sem depender da cultura/ICU do servidor.
    private static readonly System.Globalization.NumberFormatInfo PtBr = new() { NumberDecimalSeparator = ",", NumberGroupSeparator = "." };

    private DotNetObjectReference<Captura>? selfRef;

    // ── Catálogo de opções (mesmos valores do original) ──────────────────────
    private readonly List<string> comprimentos = new() { "30 cm", "40 cm", "45 cm", "55 cm", "65 cm", "75 cm", "85 cm" };
    private readonly List<string> cores = new() { "Preto", "Castanho Escuro", "Castanho Claro", "Loiro Escuro", "Loiro Médio", "Loiro Claro", "Loiro Platinado", "Ruivo", "Grisalho" };
    // O backend também aceita "Crespo"; a especificação desta tela pede três opções.
    private readonly List<string> tipos = new() { "Liso", "Ondulado", "Cacheado" };
    private readonly List<string> metodos = new() { "Fita Adesiva", "Queratina", "Micro Link", "Costurado" };

    private string comprimento = "55 cm";
    private string cor = "Castanho Escuro";
    private string tipoCabelo = "Liso";
    private string metodo = "Fita Adesiva";

    private record FiltroInfo(string Id, string Nome);
    private static readonly FiltroInfo[] Filtros =
    {
        new("natural", "Natural"), new("soft", "Soft Beauty"), new("studio", "Studio Light"),
        new("golden", "Golden Glow"), new("clean", "Clean Beauty"), new("portrait", "Soft Portrait")
    };

    // Tons de cada cor: sombra, base e brilho. Não existem fotos de fios no catálogo
    // (o catálogo do backend são máscaras de comprimento), então as amostras são desenhadas.
    private static readonly Dictionary<string, (string Escuro, string Base, string Claro)> Fios = new()
    {
        ["Preto"] = ("#0F0B0A", "#241A17", "#4A3A34"),
        ["Castanho Escuro"] = ("#2A170F", "#4A2C20", "#7A4A35"),
        ["Castanho Claro"] = ("#5A3622", "#81543A", "#B27A55"),
        ["Loiro Escuro"] = ("#7A5528", "#A47745", "#D2A56B"),
        ["Loiro Médio"] = ("#9A7433", "#C39A5A", "#E8C88C"),
        ["Loiro Claro"] = ("#BF9A55", "#E4C98C", "#F7E6BD"),
        ["Loiro Platinado"] = ("#C9BFA8", "#EDE6D6", "#FBF7EC"),
        ["Ruivo"] = ("#6E2A1A", "#A74A32", "#D9805A"),
        ["Grisalho"] = ("#7D7C77", "#AAA9A3", "#D8D7D1")
    };

    // Estas mensagens não indicam progresso: o backend não informa etapas. Descrevem os cuidados
    // da simulação, sem afirmar que algo já foi concluído.
    private static readonly string[] MensagensCarregamento =
    {
        "Preparando sua transformação…",
        "Cuidando do caimento natural dos fios…",
        "Cuidando para preservar seu rosto e o fundo da foto…",
        "Aplicando a cor e o comprimento escolhidos…",
        "Ajustando o volume e o movimento dos cabelos…",
        "Finalizando sua simulação de mega hair…"
    };

    public sealed class ResultadoFoto
    {
        public bool Ok { get; set; }
        public string? Codigo { get; set; }
        public int Largura { get; set; } = 2;
        public int Altura { get; set; } = 3;
        public string? UrlNatural { get; set; }
        public string? UrlFiltrada { get; set; }
        public string? Filtro { get; set; }
        public string? FiltroNome { get; set; }
        public string? Origem { get; set; }
        public bool Ajustada { get; set; }
    }

    private sealed class ResultadoCamera
    {
        public bool Ok { get; set; }
        public string? Codigo { get; set; }
        public bool Multiplas { get; set; }
        public bool Frontal { get; set; }
    }

    private sealed class ResultadoSalvar
    {
        public bool Ok { get; set; }
        public string? Metodo { get; set; }
        public string? Motivo { get; set; }
    }

    private sealed class ResultadoComparador
    {
        public bool Ok { get; set; }
        public bool Desalinhado { get; set; }
    }

    // ── Ciclo de vida ────────────────────────────────────────────────────────
    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(ComprimentoSugerido) && comprimentos.Contains(ComprimentoSugerido)) comprimento = ComprimentoSugerido;
        if (!string.IsNullOrWhiteSpace(CorSugerida) && cores.Contains(CorSugerida)) cor = CorSugerida;
        if (!string.IsNullOrWhiteSpace(TipoSugerido) && tipos.Contains(TipoSugerido)) tipoCabelo = TipoSugerido;
        if (!string.IsNullOrWhiteSpace(MetodoSugerido) && metodos.Contains(MetodoSugerido)) metodo = MetodoSugerido;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("megaHairEspelho.registrarArquivo", "mh-arquivo", selfRef);
        }

        if (iniciarCameraPendente)
        {
            iniciarCameraPendente = false;
            await IniciarCameraAsync();
        }

        if (iniciarComparadorPendente)
        {
            iniciarComparadorPendente = false;
            var r = await JS.InvokeAsync<ResultadoComparador>("megaHairResultado.iniciarComparador", "mh-comp-wrap");
            if (!r.Ok) { comparadorFalhou = true; StateHasChanged(); }
        }
    }

    // ── Espelho Virtual ──────────────────────────────────────────────────────
    private Task AbrirEspelhoAsync()
    {
        erro = null; erroCamera = null; cameraPronta = false;
        espelhoAberto = true;
        iniciarCameraPendente = true; // inicia depois de o <canvas> existir no DOM
        return Task.CompletedTask;
    }

    private async Task IniciarCameraAsync()
    {
        cameraPronta = false;
        var r = await JS.InvokeAsync<ResultadoCamera>("megaHairEspelho.iniciar", "mh-preview", "mh-video", cameraFrontal);
