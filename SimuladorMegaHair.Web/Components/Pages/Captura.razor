        {
            erroCamera = string.IsNullOrWhiteSpace(r.Codigo) ? "erro" : r.Codigo;
        }
        else
        {
            erroCamera = null; cameraPronta = true; cameraMultipla = r.Multiplas;
            await JS.InvokeVoidAsync("megaHairEspelho.ligarControles", "mh-controles");
        }
        StateHasChanged();
    }

    private async Task TentarCameraNovamenteAsync()
    {
        erroCamera = null;
        await IniciarCameraAsync();
    }

    private async Task AlternarCameraAsync()
    {
        cameraFrontal = !cameraFrontal;
        await IniciarCameraAsync();
    }

    private async Task CapturarAsync()
    {
        if (!cameraPronta) return;
        await JS.InvokeVoidAsync("megaHairEspelho.feedbackCaptura", "mh-palco");
        var r = await JS.InvokeAsync<ResultadoFoto>("megaHairEspelho.capturar");
        if (!r.Ok)
        {
            erro = "Não foi possível capturar a foto. Tente novamente.";
            erroCamera = "erro";
            return;
        }
        await JS.InvokeVoidAsync("megaHairEspelho.parar");
        foto = r; fotoServidorPath = null; resultado = null;
        espelhoAberto = false; cameraPronta = false; erro = null;
        etapa = Etapa.Revisao;
    }

    private async Task FecharEspelhoAsync()
    {
        await JS.InvokeVoidAsync("megaHairEspelho.parar");
        espelhoAberto = false; cameraPronta = false; erroCamera = null;
    }

    // Chamado pelo JavaScript quando a cliente escolhe uma foto da galeria.
    [JSInvokable]
    public async Task AoProcessarArquivo(ResultadoFoto r)
    {
        await InvokeAsync(async () =>
        {
            if (espelhoAberto)
            {
                await JS.InvokeVoidAsync("megaHairEspelho.parar");
                espelhoAberto = false; cameraPronta = false; erroCamera = null;
            }

            if (!r.Ok)
            {
                erro = r.Codigo switch
                {
                    "formato" => "Não consegui ler essa imagem. Use uma foto em JPG, PNG ou WEBP.",
                    "grande" => "Essa foto é muito grande. Escolha uma imagem de até 25 MB.",
                    _ => "Não foi possível carregar essa foto. Tente outra."
                };
                if (etapa != Etapa.Estilo) etapa = Etapa.Foto;
                StateHasChanged();
                return;
            }

            foto = r; fotoServidorPath = null; resultado = null; erro = null;
            etapa = Etapa.Revisao;
            StateHasChanged();
        });
    }

