        passoEstilo = 0; etapa = Etapa.Foto;
    }

    public async ValueTask DisposeAsync()
    {
        geracaoCts?.Cancel();
        geracaoCts?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("megaHairResultado.destruirComparador");
            await JS.InvokeVoidAsync("megaHairEspelho.liberar");
        }
        catch { /* circuito já encerrado */ }
        selfRef?.Dispose();
    }
