    // ── Geração ──────────────────────────────────────────────────────────────
    private async Task GerarSimulacaoAsync(bool forcarNova)
    {
        if (foto is null || etapa == Etapa.Gerando) return;

        geracaoCts?.Cancel();
        geracaoCts = new CancellationTokenSource();
        var cts = geracaoCts;
        cts.CancelAfter(TempoLimiteGeracao);
        var ct = cts.Token;

        erro = null; resultado = null; comparadorFalhou = false; salvo = false; avisoSalvar = null;
        faseEnvio = string.IsNullOrWhiteSpace(fotoServidorPath);
        indiceMensagem = 0;
        cancelamentoManual = false;
        etapa = Etapa.Gerando;
        StateHasChanged();
        _ = CiclarMensagensAsync(ct);

        try
        {
            if (string.IsNullOrWhiteSpace(fotoServidorPath))
            {
                // Sempre a foto NATURAL (sem efeitos): preserva a cor real do cabelo para a IA.
                var bytes = await JS.InvokeAsync<byte[]?>("megaHairEspelho.obterBytes", ct);
                if (bytes is null || bytes.Length == 0)
                    throw new InvalidOperationException("Não encontrei a foto. Escolha ou tire a foto novamente.");
                fotoServidorPath = await Api.UploadFotoAsync(bytes, $"foto_{Guid.NewGuid():N}.jpg", ct);
            }

            faseEnvio = false;
            await InvokeAsync(StateHasChanged);

            var request = new CriarSimulacaoRequest
            {
                FotoOriginalPath = fotoServidorPath,
                Comprimento = comprimento,
                Cor = cor,
                TipoCabelo = tipoCabelo,
                MetodoMegaHair = metodo,
                Provider = SimuladorMegaHair.Domain.Enums.ImageProvider.OpenAI,
                ClienteId = Guid.TryParse(ClienteId, out var cid) ? cid : null,
                ForcarNovaGeracao = forcarNova
            };
            // O ApiClient não repassa o CancellationToken ao HttpClient; WaitAsync garante que
            // "Cancelar" e o tempo limite realmente devolvam a tela à cliente.
            resultado = await Api.CriarSimulacaoAsync(request, ct).WaitAsync(ct);

            if (resultado is null || string.IsNullOrWhiteSpace(resultado.FotoResultadoUrl))
                throw new InvalidOperationException("A simulação não retornou imagem.");

            etapa = Etapa.Resultado;
            iniciarComparadorPendente = true;
        }
        catch (OperationCanceledException)
        {
            // Cancelada pela cliente, ou estourou o tempo limite.
            etapa = Etapa.Estilo; passoEstilo = 2;
            erro = cancelamentoManual ? null : "A simulação demorou mais do que o esperado. Vamos tentar de novo?";
        }
        catch (Exception ex)
        {
            etapa = Etapa.Estilo; passoEstilo = 2;
            erro = MensagemDeErro(ex);
        }
        finally
        {
            cts.Cancel(); // encerra o ciclo de mensagens
        }
    }

    private const string MensagemPadrao = "Não conseguimos gerar a simulação desta vez. Vamos tentar novamente?";

    // Traduz falhas técnicas em mensagens para a cliente: nunca mostra JSON, endereço interno ou stack.
    private string MensagemDeErro(Exception ex)
    {
        if (ex is HttpRequestException http)
        {
            var codigo = http.StatusCode is null ? 0 : (int)http.StatusCode.Value;
            if (codigo is 401 or 403 or 405) return ApiClient.MensagemAmigavel(ex, MensagemPadrao, Api.BaseAddress);
            if (codigo >= 400 && codigo < 500) return ExtrairMensagemDaApi(http.Message) ?? MensagemPadrao;
            if (codigo >= 500) return "Tivemos um problema para gerar sua simulação. Tente novamente em instantes.";
            return "Não conseguimos nos conectar ao servidor. Verifique sua internet e tente novamente.";
        }
        if (ex is InvalidOperationException && !string.IsNullOrWhiteSpace(ex.Message)) return ex.Message;
        return MensagemPadrao;
    }

    // O ApiClient lança "API 422: {\"erro\":\"...\"}". Aqui devolvemos só o texto do campo de erro.
    private static string? ExtrairMensagemDaApi(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return null;
        var corpo = texto.StartsWith("API ", StringComparison.Ordinal) && texto.IndexOf(": ", StringComparison.Ordinal) is var i and > 0
            ? texto[(i + 2)..].Trim()
            : texto.Trim();
        if (corpo.StartsWith('{'))
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(corpo);
                foreach (var nome in new[] { "erro", "mensagem", "message", "detail", "title" })
                {
                    foreach (var prop in doc.RootElement.EnumerateObject())
                    {
                        if (string.Equals(prop.Name, nome, StringComparison.OrdinalIgnoreCase)
                            && prop.Value.ValueKind == System.Text.Json.JsonValueKind.String
                            && !string.IsNullOrWhiteSpace(prop.Value.GetString()))
                            return prop.Value.GetString();
                    }
                }
            }
            catch (System.Text.Json.JsonException) { }
            return null;
        }
        return corpo.Length is > 0 and <= 220 && !corpo.Contains('<') ? corpo : null;
    }

    private void CancelarGeracao()
    {
        cancelamentoManual = true;
        geracaoCts?.Cancel();
    }

    private async Task CiclarMensagensAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(4200, ct);
                indiceMensagem++;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    // ── Resultado ────────────────────────────────────────────────────────────
    private async Task SalvarAsync()
    {
        if (resultado is null || salvando) return;
        salvando = true; salvo = false; avisoSalvar = null;
        StateHasChanged();
        try
        {
            var r = await JS.InvokeAsync<ResultadoSalvar>("megaHairResultado.salvar", UrlParaSalvar(), "minha-transformacao-tati-megahair.png");
            if (r.Ok) { salvo = true; }
            else if (r.Motivo == "cancelado") { /* a cliente fechou a folha de compartilhar */ }
            else avisoSalvar = "Não consegui salvar direto. Abra a imagem e segure o dedo sobre ela (ou clique com o botão direito) para salvar.";
        }
        catch { avisoSalvar = "Não consegui salvar agora. Abra a imagem e segure o dedo sobre ela para salvar."; }
        finally { salvando = false; }
    }

    // Baixa pela própria origem do site (/baixar/resultado/...), sem depender de CORS na API pública.
    private string UrlParaSalvar()
    {
        var url = resultado?.FotoResultadoUrl;
        if (string.IsNullOrWhiteSpace(url)) return string.Empty;
        try
        {
            var caminho = Uri.TryCreate(url, UriKind.Absolute, out var abs) ? abs.AbsolutePath : url;
            var nome = System.IO.Path.GetFileName(caminho);
            if (!string.IsNullOrWhiteSpace(nome)) return "/baixar/resultado/" + Uri.EscapeDataString(nome);
        }
        catch { /* usa a URL original */ }
        return url;
    }

