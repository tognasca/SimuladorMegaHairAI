@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Mega Hair AI</PageTitle>

<div style="display:flex; flex-direction:column; align-items:center; padding-top:40px; gap:24px;">

    <img src="images/logo_tati.png" style="height:140px; object-fit:contain;" alt="Logo" />

    <p class="eyebrow">Salão · Inteligência Artificial</p>
    <h1 class="sim-title" style="margin-top:4px;">Mega Hair AI</h1>
    <p style="color:var(--text-secondary); font-size:15px; max-width:360px; text-align:center; margin:0;">
        Visualize o Mega Hair na foto da cliente, com o rosto preservado.
    </p>

    <div class="menu-grid" style="width:100%;">

        <a href="/captura" class="btn-gold" style="display:flex; flex-direction:column; gap:2px; padding:18px 20px;">
            <span>✦ NOVA SIMULAÇÃO</span>
            <span style="font-weight:400; font-size:11px; opacity:0.8;">Tirar ou escolher uma foto</span>
        </a>

        <a href="/clientes" class="btn-outline" style="display:flex; flex-direction:column; gap:2px; padding:18px 20px;">
            <span>♙ BUSCAR CLIENTE</span>
            <span style="font-weight:400; font-size:11px; color:var(--text-muted);">Ver histórico de quem já simulou</span>
        </a>

        <a href="/catalogo" class="btn-outline" style="display:flex; flex-direction:column; gap:2px; padding:18px 20px;">
            <span>▣ CATÁLOGO</span>
            <span style="font-weight:400; font-size:11px; color:var(--text-muted);">Cabelos, cores e preços</span>
        </a>

    </div>

</div>
