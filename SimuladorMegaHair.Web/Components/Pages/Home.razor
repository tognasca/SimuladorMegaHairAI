@page "/"

<PageTitle>Mega Hair AI — Sua nova versão</PageTitle>

<div class="beauty-home">
    <section class="beauty-home-hero">
        <div class="beauty-home-copy">
            <p class="beauty-eyebrow">Tati Mega Hair · Beleza inteligente</p>
            <h1>Seu próximo visual começa antes do salão.</h1>
            <p class="beauty-home-lead">Experimente comprimentos, cores e texturas com IA antes de realizar o procedimento. Uma forma mais segura, leve e inspiradora de escolher sua transformação.</p>
            <div class="beauty-home-actions">
                <a href="/captura" class="beauty-primary-action">✦ Experimentar agora</a>
                <a href="/catalogo" class="beauty-home-text-link">Explorar catálogo <span>→</span></a>
            </div>
            <div class="beauty-home-proof"><span>✦</span> Visualização personalizada <span>·</span> Resultado com acabamento natural</div>
        </div>

        <div class="beauty-hero-visual" aria-label="Exemplo visual de transformação antes e depois">
            <div class="beauty-visual-caption"><span>ANTES</span><span>DEPOIS</span></div>
            <div class="beauty-portrait portrait-before"><div class="beauty-portrait-hair"></div><div class="beauty-portrait-face"></div></div>
            <div class="beauty-portrait portrait-after"><div class="beauty-portrait-hair"></div><div class="beauty-portrait-face"></div><div class="beauty-hair-length"></div></div>
            <div class="beauty-visual-badge"><span>IA</span><small>Seu estilo<br />em novas versões</small></div>
        </div>
    </section>

    <section class="beauty-home-benefit-strip">
        <div><span>01</span><strong>Visualize antes de decidir</strong><small>Mais segurança para escolher.</small></div>
        <div><span>02</span><strong>Explore seu potencial</strong><small>Teste cores e comprimentos.</small></div>
        <div><span>03</span><strong>Encontre seu match</strong><small>Uma proposta para você.</small></div>
    </section>

    <section class="beauty-home-next">
        <div>
            <p class="beauty-eyebrow">Uma experiência pensada para você</p>
            <h2>Foto → estilo → transformação.</h2>
        </div>
        <a href="/captura" class="beauty-secondary-action">Começar minha simulação →</a>
    </section>
</div>

<style>
.beauty-home { max-width: 1180px; margin: 0 auto; padding: 28px 0 70px; color: var(--text-primary); }
.beauty-home-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(390px, .85fr); gap: 70px; align-items: center; min-height: 570px; }
.beauty-home-copy h1 { max-width: 620px; margin: 0; color: var(--text-primary); font-family: "Cormorant Garamond", Georgia, serif; font-size: clamp(54px, 7vw, 86px); font-weight: 600; line-height: .9; letter-spacing: -.045em; }
.beauty-home-lead { max-width: 520px; margin: 28px 0; color: var(--text-secondary); font-size: 17px; line-height: 1.65; }
.beauty-home-actions { display: flex; align-items: center; gap: 24px; }
.beauty-home-actions .beauty-primary-action { width: auto; min-width: 210px; margin: 0; }
.beauty-home-text-link { color: var(--text-primary); font-size: 13px; font-weight: 700; }
.beauty-home-text-link span { margin-left: 8px; color: var(--terracotta); font-size: 18px; }
.beauty-home-proof { margin-top: 32px; color: var(--text-muted); font-size: 11px; letter-spacing: .04em; }
.beauty-home-proof span { color: var(--gold); margin: 0 5px; }
.beauty-hero-visual { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; min-height: 480px; padding: 40px 34px 34px; border-radius: 30px; background: linear-gradient(145deg, #eeece8, #ddd9d3 60%, #c7c0ba); box-shadow: 0 24px 60px rgba(46, 42, 39, .12); transform: rotate(2deg); }
.beauty-visual-caption { position: absolute; top: 18px; left: 34px; right: 34px; display: flex; justify-content: space-between; color: rgba(56, 41, 35, .62); font-size: 10px; font-weight: 700; letter-spacing: .2em; }
.beauty-portrait { position: relative; overflow: hidden; min-height: 400px; border-radius: 90px 90px 22px 22px; background: #d8d3cd; }
.beauty-portrait-face { position: absolute; z-index: 2; top: 27%; left: 23%; width: 54%; height: 38%; border-radius: 48% 48% 44% 44%; background: linear-gradient(145deg, #b99d8c, #dbc9b8); }
.beauty-portrait-face::before, .beauty-portrait-face::after { content: ""; position: absolute; top: 44%; width: 4px; height: 4px; border-radius: 50%; background: #514a46; }
.beauty-portrait-face::before { left: 27%; }.beauty-portrait-face::after { right: 27%; }
.beauty-portrait-hair { position: absolute; z-index: 1; top: 9%; left: 13%; width: 74%; height: 54%; border-radius: 52% 52% 40% 40%; background: #544c47; }
.beauty-portrait-hair::after { content: ""; position: absolute; top: 42%; left: -9%; width: 118%; height: 66%; border-radius: 50%; background: #544c47; }
.portrait-after { background: #c9c3bd; }.portrait-after .beauty-portrait-hair { background: #8d8172; height: 61%; }.portrait-after .beauty-portrait-hair::after { background: #8d8172; height: 86%; border-radius: 44% 44% 52% 52%; }
.beauty-hair-length { position: absolute; z-index: 1; top: 41%; left: 7%; width: 86%; height: 55%; border-radius: 40% 40% 50% 50%; background: repeating-linear-gradient(95deg, #8d8172 0, #a49786 5px, #766b61 10px); opacity: .9; }
.beauty-visual-badge { position: absolute; right: -18px; bottom: 26px; display: flex; align-items: center; gap: 10px; padding: 12px 15px; border-radius: 14px; background: #f8f7f4; color: var(--text-primary); box-shadow: 0 12px 25px rgba(46, 42, 39, .14); transform: rotate(-4deg); }
.beauty-visual-badge span { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--terracotta); color: #fff; font-size: 11px; font-weight: 700; }.beauty-visual-badge small { font-size: 11px; line-height: 1.3; }
.beauty-home-benefit-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; padding: 25px 0; border-top: 1px solid var(--border-soft); border-bottom: 1px solid var(--border-soft); }
.beauty-home-benefit-strip div { display: grid; grid-template-columns: 34px 1fr; column-gap: 10px; }.beauty-home-benefit-strip span { grid-row: span 2; color: var(--gold); font-family: "Cormorant Garamond", serif; font-size: 24px; }.beauty-home-benefit-strip strong { font-size: 13px; }.beauty-home-benefit-strip small { margin-top: 5px; color: var(--text-muted); font-size: 11px; }
.beauty-home-next { display: flex; justify-content: space-between; align-items: end; gap: 20px; padding-top: 58px; }.beauty-home-next h2 { margin: 0; font-family: "Cormorant Garamond", Georgia, serif; font-size: 42px; font-weight: 600; }.beauty-home-next .beauty-secondary-action { width: auto; white-space: nowrap; }
@@media (max-width: 900px) { .beauty-home { padding-top: 0; }.beauty-home-hero { grid-template-columns: 1fr; gap: 42px; }.beauty-home-copy h1 { max-width: 650px; }.beauty-hero-visual { max-width: 520px; width: 100%; margin: 0 auto; }.beauty-home-next { align-items: flex-start; flex-direction: column; } }
@@media (max-width: 640px) { .beauty-home { padding-bottom: 35px; }.beauty-home-hero { min-height: 0; gap: 28px; }.beauty-home-copy h1 { font-size: 57px; }.beauty-home-lead { margin: 20px 0; font-size: 15px; }.beauty-home-actions { align-items: stretch; flex-direction: column; gap: 15px; }.beauty-home-actions .beauty-primary-action { width: 100%; }.beauty-home-text-link { text-align: center; }.beauty-hero-visual { min-height: 360px; padding: 34px 18px 18px; gap: 7px; border-radius: 22px; }.beauty-visual-caption { left: 20px; right: 20px; }.beauty-portrait { min-height: 300px; border-radius: 60px 60px 15px 15px; }.beauty-home-benefit-strip { grid-template-columns: 1fr; gap: 18px; }.beauty-home-next h2 { font-size: 36px; }.beauty-home-next .beauty-secondary-action { width: 100%; } }
</style>
