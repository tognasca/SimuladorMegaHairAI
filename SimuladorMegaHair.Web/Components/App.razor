<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>Mega Hair AI</title>
    <base href="/" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="icon" type="image/png" href="images/logo_tati.png" />

    <!--
        theme-color + apple-mobile-web-app: permite "Adicionar à Tela de
        Início" no iPad/iPhone (Safari) e no Android, fazendo o site
        abrir em tela cheia, sem barra de endereço — parecido com um app
        nativo, sem passar pela App Store/Play Store.
    -->
    <meta name="theme-color" content="#0A0A0C" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="apple-touch-icon" href="images/logo_tati.png" />

    <HeadOutlet />
</head>

