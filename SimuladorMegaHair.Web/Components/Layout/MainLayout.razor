@inherits LayoutComponentBase
@inject SimuladorMegaHair.Web.Services.AuthTokenStore TokenStore
@inject NavigationManager Nav

<div class="app-shell">

    <nav class="sidebar">
        <div class="sidebar-logo">
            <img src="images/logo_tati.png" alt="Logo" />
            <span class="sidebar-logo-text">TATI MEGA HAIR</span>
        </div>

        <a class="sidebar-item" href="/">
            <span class="sidebar-icon">⌂</span>
            <span class="sidebar-label">Início</span>
        </a>
        <a class="sidebar-item" href="/captura">
            <span class="sidebar-icon">✦</span>
            <span class="sidebar-label">Nova Simulação</span>
        </a>
        <a class="sidebar-item" href="/clientes">
            <span class="sidebar-icon">♙</span>
            <span class="sidebar-label">Clientes</span>
        </a>
        <a class="sidebar-item" href="/catalogo">
            <span class="sidebar-icon">▣</span>
            <span class="sidebar-label">Catálogo</span>
        </a>

        @if (TokenStore.EstaAutenticado)
        {
            <div style="margin-top:auto; padding-top:16px; border-top:1px solid var(--border-soft, #2a2a30);">
                <div style="font-size:11px; color:var(--text-muted); padding:0 12px 8px;">
                    @TokenStore.EmailUsuario
                </div>
                <a class="sidebar-item" href="#" @onclick="SairAsync" @onclick:preventDefault>
                    <span class="sidebar-icon">⏻</span>
                    <span class="sidebar-label">Sair</span>
                </a>
            </div>
        }
    </nav>

    <main class="app-main">
        @Body
    </main>

</div>

@code {
    private async Task SairAsync()
    {
        await TokenStore.LimparAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }
}
